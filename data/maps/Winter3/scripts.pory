mapscripts Winter3_MapScripts {
}

script Winter3_1 {
    checkbossstatus(7)
    if (var(VAR_RESULT) == TRUE) {
        msgbox("The image of {STR_VAR_1} has faded.")
        waitmessage
        release
        end
    }
    choosecurrentboss(7)
    waitstate
    if (var(VAR_RESULT) == TRUE) {
        warpsilent(MAP_WINTER3BOSS, 15 , 10)
    }
    release
}

