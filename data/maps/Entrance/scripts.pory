script Entrance_Lugia {
    msgbox("Hunt Lugia?", MSGBOX_YESNO)
    closemessage
    if (var(VAR_RESULT) == YES) {
        setuphunt(FINAL_BOSS_LUGIA)
        warpsilent(MAP_MYTH_HUB, 20, 18)
    }
}
