mapscripts Entrance_MapScripts {
    MAP_SCRIPT_ON_RESUME {
        callnative(Init_PulseNeonLights)
    }
    MAP_SCRIPT_ON_TRANSITION: Entrance_SatsukiPosition
}

const satsuki = ENTRANCE_SATSUKI
const player = OBJ_EVENT_ID_PLAYER
const morgan = ENTRANCE_MORGAN

script Entrance_SatsukiPosition {
    if(var(VAR_STORY) == 0) {
        setobjectxyperm(satsuki, 25, 10)
    }
    else {
        setobjectxyperm(satsuki, 32, 12)
    }
}

script Entrance_FirstDay_Top {
    lock
    applymovement(satsuki, moves(walk_down*2))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Good morning {PLAYER}.\pUp nice and early, hmm?")
    applymovement(player, moves(walk_right*2))
    waitmovement(player)
    goto(Entrance_FirstDay)
}

script Entrance_FirstDay_Mid {
    lock
    applymovement(satsuki, moves(walk_down*2))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Good morning {PLAYER}.\pUp nice and early, hmm?")
    applymovement(player, moves(walk_right, walk_up))
    waitmovement(player)
    goto(Entrance_FirstDay)
}

script Entrance_FirstDay_Bot {
    lock
    applymovement(satsuki, moves(walk_down*2))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Good morning {PLAYER}.\pUp nice and early, hmm?")
    applymovement(player, moves(walk_up*2))
    waitmovement(player)
    goto(Entrance_FirstDay)
}


script Entrance_FirstDay {
    closemessage
    applymovement(player, moves(walk_up*3, walk_right))
    waitmovement(player)
    applymovement(satsuki, moves(face_left))
    applymovement(player, moves(walk_in_place_right))
    msgbox("{SPEAKER NAME_PLAYER}So are you, miss Satsuki.\p"
            "You look like you just rolled out\nof bed yourself.")
    closemessage
    applymovement(satsuki, moves(face_down, delay_16*3, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}… No matter. I did say we could\nsleep in for once.\p"
            "You've … definitely taken that\nopportunity.")
    waitmessage
    applymovement(satsuki, moves(walk_right, walk_up))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}The birds have long ceased their\nmorning chatter.")
    closemessage
    applymovement(satsuki, moves(face_left))
    playse(SE_LEDGE)
    applymovement(player, moves(jump_in_place_right))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Hey hey, I don't get to celebrate\nmy graduation every day!")
    applymovement(satsuki, moves(walk_down, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Fufufu, you are right.\pI was just pulling your leg.\p"
            "So, do you still remember your\ntraining, or did all the partying\llast night muddy up your memory?")
    setboxframe(BOX_FRAME_TIANA)
    dynmultichoice(0,0, TRUE, 2, 1, DYN_MULTICHOICE_CB_NONE,
                    "Ofcourse I still remember.",
                    "Uhhh…")
    if(var(VAR_RESULT)==0){
        goto(Entrance_SatsukiIntro)
    }
    else {
        goto(Entrance_SatsukiBattle)
    }
}

script Entrance_SatsukiBattle {
    applymovement(satsuki, moves(face_up))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Honestly…\pAll that practice and studying,\nyet you still forget everything\lthe moment you graduate…")
    waitmessage
    applymovement(satsuki, moves(face_left))
    msgbox("It appears I have to teach\nmy student one more lesson.\pSteady yourself.")
    closemessage
    msgbox("placeholder battle")
    msgbox("{SPEAKER NAME_SATSUKI}That should cover the gaps in\nyour knowledge.\p"
            "Now, let's move on. We don't have\nall day.")
    closemessage
    applymovement(satsuki, moves(face_down))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Less than half a day, in fact.")
    closemessage
    applymovement(satsuki, moves(face_left))
    waitmovement(satsuki)
    goto(Entrance_StartingAnAdventure)
}

script Entrance_SatsukiIntro {
    msgbox("{SPEAKER NAME_SATSUKI}Excellent, that means you can get\nstarted right away.")
    waitmessage
    goto(Entrance_StartingAnAdventure)
}

script Entrance_StartingAnAdventure {
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_left*4, walk_diag_northwest))
    applymovement(player, moves(delay_16*2, face_left))
    waitmovement(LOCALID_CAMERA)
    msgbox("{SPEAKER NAME_SATSUKI}From now on, you can select your\nstrategy there.")
    closemessage
    applymovement(LOCALID_CAMERA, moves(walk_right*2, walk_diag_northeast*2, walk_right*3))
    applymovement(satsuki, moves(delay_16*2, face_up))
    applymovement(player, moves(delay_16*2, face_up))
    waitmovement(LOCALID_CAMERA)
    msgbox("{SPEAKER NAME_SATSUKI}Interact with the Bodhai Tree\nto enter a Myth")
    closemessage
    applymovement(LOCALID_CAMERA, moves(walk_down, walk_diag_southwest*2))
    waitmovement(LOCALID_CAMERA)
    applymovement(satsuki, moves(face_left))
    applymovement(player, moves(face_right))
    special(RemoveCameraObject)
    msgbox("{SPEAKER NAME_SATSUKI}Remember, once you're in a story,\nyou cannot receive any help\lfrom outside.\p"
            "Make sure to use all the information\nthe tree provides.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Satsuki, we've gone over this so.{PAUSE 30}\nmany.{PAUSE 30} times.{PAUSE 30}\p"
            "I got it, okay?")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Wonderful.\p"
            "As you know, the Bodhai Tree\nwrites records of what you do\lautomatically.\p"
            "And since your work will now\nbe public, I do not want to see\lany nonsense.\pGot it?\p"
            "I've loaded in the Myths we have\nyet to understand.\pI look forward to your\ndiscoveries.")
    closemessage
    applymovement(player, moves(walk_in_place_right))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Mhm, I'll give it my all!\pI know the drill by now, miss Satsuki.")
    waitmessage
    msgbox("{SPEAKER NAME_SATSUKI}Fufu, that's the spirit.\p"
            "I assume you've still got all your\nstudy notes written down in the\lterminal in your room, right?")
    applymovement(player, moves(face_down, delay_16*2, face_right))
    msgbox("{SPEAKER NAME_PLAYER}Well, I have{PAUSE 10}.{PAUSE 10}.{PAUSE 10}. most of it, yeah!\n{PAUSE 50}I think.")
    closemessage
    applymovement(satsuki, moves(walk_right*2, delay_16*2, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Oh right, one more thing.")
    waitmessage
    applymovement(satsuki, moves(face_down, delay_16*3, face_left))
    waitmovement(satsuki)
    msgbox("The library is now open to the public\nagain.\p"
            "Since you are now officially a\nRecordkeeper, I expect you treat\lour guests properly.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Ofcourse! I'll be on my best behaviour,\nboss!")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Good.")
    applymovement(satsuki, moves(walk_right*4))
    waitmovement(satsuki)
    setobjectxyperm(satsuki, 32, 12)
    setvar(VAR_STORY, 1)
    closemessage
    release
}

script Entrance_PickWeather {
    lock
    msgbox("Select Affinity")
    setboxframe(BOX_FRAME_PC)
    dynmultichoice(0,0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
                    "Sun",
                    "Rain",
                    "Sand",
                    "Snow",
                    "Random")
    switch(var(VAR_RESULT)) {
        case 0: setvar(VAR_TEMP_1, 0)
                goto(Entrance_PickWeather_Set)
        case 1: setvar(VAR_TEMP_1, 1)
                goto(Entrance_PickWeather_Set)
        case 2: setvar(VAR_TEMP_1, 2)
                goto(Entrance_PickWeather_Set)
        case 3: setvar(VAR_TEMP_1, 3)
                goto(Entrance_PickWeather_Set)
        case 4: setaffinity(MON_LIST_RANDOM)
                goto(Entrance_PickWeather_Exit)
    }
    closemessage
}

script Entrance_PickWeather_Set {
    msgbox("Select style")
    setboxframe(BOX_FRAME_PC)
    dynmultichoice(0,0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Grace",
                    "Favor",
                    "Prayer",)
    switch(var(VAR_RESULT)) {
        case 0: switch(var(VAR_TEMP_1)) {
            case 0: setaffinity(MON_LIST_SUN_DIRECT)
            case 1: setaffinity(MON_LIST_RAIN_DIRECT)
            case 2: setaffinity(MON_LIST_SAND_DIRECT)
            case 3: setaffinity(MON_LIST_SNOW_DIRECT)
            }
            goto(Entrance_PickWeather_Exit)
        case 1: switch(var(VAR_TEMP_1)) {
            case 0: setaffinity(MON_LIST_SUN_CONDITIONAL)
            case 1: setaffinity(MON_LIST_RAIN_CONDITIONAL)
            case 2: setaffinity(MON_LIST_SAND_CONDITIONAL)
            case 3: setaffinity(MON_LIST_SNOW_CONDITIONAL)
           }
           goto(Entrance_PickWeather_Exit)
        case 2: switch(var(VAR_TEMP_1)) {
            case 0: setaffinity(MON_LIST_SUN_MANUAL)
            case 1: setaffinity(MON_LIST_RAIN_MANUAL)
            case 2: setaffinity(MON_LIST_SAND_MANUAL)
            case 3: setaffinity(MON_LIST_SNOW_MANUAL)
           }
            goto(Entrance_PickWeather_Exit)
        }
    goto(Entrance_PickWeather)
}

script Entrance_PickWeather_Exit {
    msgbox("Affinity confirmed")
    closemessage
    release
}

script Entrance_Boss {
    msgbox("Confirm Myth to uncover.")
    setboxframe(BOX_FRAME_BODHAI)
    dynmultichoice(0,0,FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
                    "Overflowing Abundance",
                    "Quest for the flooded lands",
                    "The Original Sinner",
                    "Exit")
    switch(var(VAR_RESULT)) {
        case 0: setuphunt(FINAL_BOSS_XERNEAS)
            msgbox(format("Initializing 'Overflowing Abundance'\n{PAUSE 15}. {PAUSE 15}. {PAUSE 15}."))
            goto(Entrance_BossStart)
        case 1: setuphunt(FINAL_BOSS_LUGIA)
            msgbox(format("Initializing 'Quest for the flooded lands'\n{PAUSE 15}. {PAUSE 15}. {PAUSE 15}."))
            goto(Entrance_BossStart)
        case 2: setuphunt(FINAL_BOSS_GIRATINA)
            msgbox(format("Initializing 'The Original Sinner'\n{PAUSE 15}. {PAUSE 15}. {PAUSE 15}."))
            goto(Entrance_BossStart)
        case 3: closemessage
                release
    }
    closemessage
    release
}

script Entrance_BossStart {
    msgbox("Myth initialized succesfully.{PAUSE 60}\nEntering story.")
    warpsilent(MAP_MYTH_HUB, 20, 18)
}

script Entrance_Satsuki {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_SATSUKI}Hmm? Something the matter?")
    // totalmythscleared
    // if(var(VAR_RESULT) >= 2){
    //     msgbox("You've cleared 2 myths!")
    // }
    // else {
    //     msgbox("You have not cleared 2 myths")
    // }
    dynmultipush("Got anything new?", 0)
    dynmultipush("How's my progress?",1)
    //if var story == 2
    dynmultipush("I managed to clear one of the stories!",2)
    closemessage
    release
}

script Entrance_PlayerTerminal {
    lock
    if(var(VAR_STORY)== 0){
        msgbox("{SPEAKER NAME_PLAYER}It's already late, I don't have time\nto review anything right now!")
    }
    msgbox("{SPEAKER NAME_PLAYER}Time for another review...")
    closemessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Story structure",
                    "Battle mechanics",
                    "Affinity",
                    "Exit")
    switch(var(VAR_RESULT)){
        case 0: goto(Entrance_PlayerTerminal_Story)
        case 1: goto(Entrance_PlayerTerminal_Battle)
        case 2: goto(Entrance_PlayerTerminal_Affinity)
        case 3: goto(Entrance_PlayerTerminal_Exit)
    }
    goto(Entrance_PlayerTerminal_Exit)
}

script Entrance_PlayerTerminal_Exit {
    closemessage
    release
}

script Entrance_PlayerTerminal_Story {
    msgbox("Hmm... I think I had my notes on the\nrecording process here.")
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "General structure",
                    "Initializing Pokémon",
                    "Obtaining moves",
                    "Gaining abilities",
                    "Back")
    switch(var(VAR_RESULT)){
        case 0: msgbox(Entrance_Text_Structure)
            goto(Entrance_PlayerTerminal_Story)
        case 1: msgbox(Entrance_Text_Pokemon)
            goto(Entrance_PlayerTerminal_Story)
        case 2: msgbox(Entrance_Text_Moves)
            goto(Entrance_PlayerTerminal_Story)
        case 3: msgbox(Entrance_Text_Abilities)
            goto(Entrance_PlayerTerminal_Story)
        case 4: goto(Entrance_PlayerTerminal)
    }
    goto(Entrance_PlayerTerminal)
}

text Entrance_Text_Structure {
    "The Bodhai system creates a similar\nstructure for each myth.\p"
    "Select a myth to examine.\nThe system will create a boss\lassociated with the myth.\p"
    "It will also generate 9 subdomains.\p"
    "Each domain contains a single\npowerful opponent, as well as\na number of weaker enemies.\p"
    "They represent the obstacles\nthe protagonists had to overcome.\p"
    "The final boss can be challenged\nat any time.\p"
    "Depending on the number of\nsubdomains entered, the story may\lreach different conclusions."
}

text Entrance_Text_Pokemon {
    "I can bring 3 Pokémon into\na myth.\p"
    "They are initialized via the\nBodhai system.\p"
    "There are no levels, but they\ncan become stronger through\lother means."
}

text Entrance_Text_Moves {
    "The Pokémon I start off with know 2 moves."
    "Defeating a minor enemy in a subdomain rewards a move."
    "This move can be assigned to a Pokémon via the Pokémon menu."
    "Select the move and press {A_BUTTON} to assign it to the currently viewed Pokémon."
    "To remove an assigned move, select it and press {A_BUTTON}."
    "Any move can be put onto any Pokémon, and starting moves can also be switched around."
    "Lastly, rewarded moves also increase the Pokémon's stats."
}

text Entrance_Text_Abilities {
    "Pokemon initialized by the Bodhai Tree start with a single ability."
    "Unlike starting moves, this ability is not removable."
    "Defeating the boss in a subdomain rewards an ability."
    "Obtained abilities can be assigned to any Pokémon, and swapped at will."
}

script Entrance_PlayerTerminal_Battle {
    msgbox("Right, the Tree's battle system is a bit different from usual battles.")
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Switching around",
                    "Backline",
                    "Phases",
                    "Cooldowns",
                    "Abilities",
                    "Stat boosts",
                    "Back")
    switch(var(VAR_RESULT)){
        case 0: msgbox(Entrance_Text_Switching)
            goto(Entrance_PlayerTerminal_Battle)
        case 1: msgbox(Entrance_Text_Backline)
            goto(Entrance_PlayerTerminal_Battle)
        case 2: msgbox(Entrance_Text_Phases)
            goto(Entrance_PlayerTerminal_Battle)
        case 3: msgbox(Entrance_Text_Cooldowns)
            goto(Entrance_PlayerTerminal_Battle)
        case 4: msgbox(Entrance_Abilities)
            goto(Entrance_PlayerTerminal_Battle)
        case 5: msgbox(Entrance_StatBoosts)
            goto(Entrance_PlayerTerminal_Battle)
        case 6: goto(Entrance_PlayerTerminal)
    }
    goto(Entrance_PlayerTerminal)
}

text Entrance_Text_Switching {
    "Apparantly switching works like rotation battles. Never heard of them, though."
    "All my Pokémon are on the field at the same time, and they can be switched without taking up a turn."
    "Abilities that activate on switch-in do require the Pokémon to take a turn, though."
}

text Entrance_Text_Backline {
    "When not the active battler, a Pokémon will restore a bit of health every turn."
    "After 3 turns of being in the back, they will get rid of any negative stat drops."
    "And after 5 turns, they'll heal negative status effects"
    "Well, most of them."
}

text Entrance_Text_Phases {
    "All enemies have multiple phases."
    "Dealing enough damage puts the opponent to the next phase."
    "When this happens, they cure themselves of any statuses."
    "One neat trick is that if they're pushed to the next phase before they move in the turn, they flinch!"
}

text Entrance_Text_Cooldowns {
    "Some moves and abilities have cooldowns."
    "After activating, they won't do so until a number of turns have passed."
    "Moves can be used when on cooldown, but this will deal recoil damage."
}

text Entrance_Abilities {
    "Just like my own Pokémon, enemies can also have multiple abilities"
    "The longer the story goes on, the more abilities they will have..."
}

text Entrance_StatBoosts {
    "To improve consistency, the Bodhai Tree makes stat boost levels less drastic."
    "There are still six stages, but the maximum is a 2x multiplier."
    "or a 0.5x for negative stat changes."
}

script Entrance_PlayerTerminal_Affinity {

}

script Entrance_PrayerGirl {
    lock
    faceplayer
    callnative(CheckHasDanced)
    switch (var(VAR_RESULT)) {
    case 0:
        msgbox("{SPEAKER NAME_KIO}You're a Recordkeeper! Could you show\nme a prayer dance?")
        setboxframe(BOX_FRAME_TIANA)
        dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                        "Sure!",
                        "Not right now.",
                        "No.")
        switch(var(VAR_RESULT)) {
        case 0:
            msgbox("{SPEAKER NAME_KIO}Yay!")
            waitmessage
            closemessage
            goto(Entrance_DoPrayerDance)
        case 1:
            msgbox("{SPEAKER NAME_KIO}I'll look forward to it!")
            waitmessage
            release
        case 2:
            msgbox("{SPEAKER NAME_KIO}Oh… Maybe I can ask again later?")
            waitmessage
            release
        }
    case 1:
        msgbox("{SPEAKER NAME_KIO}Thanks you for showing me the dance!")
        waitmessage
        release
    }
}

script Entrance_DoPrayerDance {
    callnative(GetPositionForDance)
    switch(var(VAR_RESULT)) {
    case 0:
        applymovement(player, moves(walk_right, walk_down))
        waitmovement
        applymovement(LOCALID_KIO, moves(face_right))
        applymovement(player, moves(walk_right, walk_right))
        waitmovement
        release
    case 1:
        applymovement(player, moves(walk_right*2))
        waitmovement
        release
    case 2:
        applymovement(player, moves(walk_right, walk_up))
        waitmovement
        applymovement(LOCALID_KIO, moves(face_right))
        applymovement(player, moves(walk_right, walk_right))
        waitmovement
        release
    }
    callnative(SetupPrayerDance)
    setmetatile(10, 25, 0x26, TRUE)
    setmetatile(10, 26, 0x26, TRUE)
    setmetatile(10, 27, 0x26, TRUE)
    setmetatile(9, 28, 0x26, TRUE)
    setmetatile(8, 28, 0x26, TRUE)
    setmetatile(7, 28, 0x26, TRUE)
    setmetatile(6, 27, 0x26, TRUE)
    setmetatile(6, 26, 0x26, TRUE)
    setmetatile(6, 25, 0x26, TRUE)
}

script Entrance_DanceDone {
    lock
    callnative(GetPositionForDanceDone)
    switch(var(VAR_RESULT)){
    case 0:
        applymovement(player, moves(walk_right, walk_down, face_left))
        waitmovement
    case 1:
        applymovement(player, moves(walk_right, face_left))
        waitmovement
    case 2:
        applymovement(player, moves(walk_right, walk_up, face_left))
        waitmovement
    case 3:
        applymovement(player, moves(walk_down, face_left))
        waitmovement
    case 4:
        applymovement(player, moves(face_left))
        waitmovement
    case 5:
        applymovement(player, moves(walk_up, face_left))
        waitmovement
    case 6:
        applymovement(player, moves(walk_down, walk_left))
        waitmovement
    case 7:
        applymovement(player, moves(walk_left))
        waitmovement
    case 8:
        applymovement(player, moves(walk_up, walk_left))
        waitmovement
    }
    applymovement(player, moves(face_up, delay_1*3 face_right, delay_1*3,,,, face_down, delay_1*3, face_left, delay_1*3, jump_in_place_left))
    waitmovement
    applymovement(LOCALID_KIO, moves(emote_heart, jump_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_KIO}Yay! That was so cute!\pThank you!")

    setmetatile(10, 25, 0x13, FALSE)
    setmetatile(10, 26, 0xB, FALSE)
    setmetatile(10, 27, 0x13, FALSE)
    setmetatile(9, 28, 0x20A, FALSE)
    setmetatile(8, 28, 0x209, FALSE)
    setmetatile(7, 28, 0x208, FALSE)
    setmetatile(6, 27, 0x99, FALSE)
    setmetatile(6, 26, 0x91, FALSE)
    setmetatile(6, 25, 0x89, FALSE)

    release
}

script Entrance_Receptionist_Direct {
    lock
    faceplayer
    msgbox("P{SPEAKER NAME_NAOTO}lease {PLAYER}, don't walk behind the\ncounter while the library is open.\pYou should know this…")
    setboxframe(BOX_FRAME_TIANA)
    dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
                    "What if I want to hug my fav clerk?",
                    "I have to keep you on your toes somehow.")
    switch (var(VAR_RESULT)) {
    case 0:
        msgbox("{SPEAKER NAME_NAOTO}Then I'll tell Fuan you asked for her.")
        msgbox("{SPEAKER NAME_PLAYER}Aww, don't be like that. I like\nyou too!")
        msgbox("{SPEAKER NAME_NAOTO}Then show your appreciation from the\nother side of the counter.")
    case 1:
        msgbox("{SPEAKER NAME_NAOTO}You did that quite well during the\n"
               "two weeks you were practicing your\l"
               "spin throw thing.")
        msgbox("{SPEAKER NAME_PLAYER}You said you wouldn't mention\nthat again…")
        msgbox(format("{SPEAKER NAME_NAOTO}And you said you'd stay on the other side of the counter. So here we are."))
    }
    closemessage
    callnative(GetBehindCounterPos)
    applymovement(LOCALID_NAOTO, moves(face_right))
    switch (var(VAR_RESULT)) {
    case 0:
        applymovement(LOCALID_PLAYER, moves(walk_left, walk_down, walk_down))
    case 1:
        applymovement(LOCALID_PLAYER, moves(walk_left, walk_left, walk_down))
    case 2:
        applymovement(LOCALID_PLAYER, moves(walk_left, walk_left, walk_down, walk_down, walk_down))
    }
    waitmovement
    setflag(FLAG_PESTERED_NAOTO)
    release
}

script Entrance_Receptionist_Glare {
    if (flag(FLAG_PESTERED_NAOTO)) {
        lock
        applymovement(LOCALID_NAOTO, moves(face_left))
        waitmovement
        msgbox("{SPEAKER NAME_PLAYER}(placeholder)")
        applymovement(LOCALID_PLAYER, moves(walk_down))
        waitmovement
        applymovement(LOCALID_NAOTO, moves(face_right))
        waitmovement
        release
    }
}

script Entrance_Receptionist_Counter {
    lock
    msgbox("{SPEAKER NAME_NAOTO}For once you did it correctly.")
    waitmessage
    release
}

script Entrance_PottedPlantMan {
    lock
    faceplayer
    switch (var(VAR_POTTED_PLANT_MAN)) {
    case 1:
        msgbox("{SPEAKER NAME_HIDEAKI}Do people jump over to the platform?")
    case 2:
        msgbox("{SPEAKER NAME_HIDEAKI}Or is there a watering can with a\nreally long pipe?")
    case 3:
        msgbox("{SPEAKER NAME_HIDEAKI}Or does someone here have really\ngood aim with a hose?")
    case 4:
        msgbox("{SPEAKER NAME_HIDEAKI}They could maybe grab the pots with\nwith something and lift them over\lto their side…")
    case 5:
        msgbox("{SPEAKER NAME_HIDEAKI}Or they could throw water balloons\nat the pots.\pNo, that would be stupid.")
    case 6:
        msgbox("{SPEAKER NAME_HIDEAKI}You know those claw machines in\narcades?")
        setboxframe(BOX_FRAME_TIANA)
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
                        "Yes?",
                        "And that's relevant, how?")
        msgbox("{SPEAKER NAME_HIDEAKI}What if there's one of those in the\nroof that picks up the pots and\lbrings it over?")
        msgbox("{SPEAKER NAME_PLAYER}(How does he even come up with\nall these ideas?)")
    case 7:
        msgbox("{SPEAKER NAME_HIDEAKI}They could have some Water type\nPokémon, they probably have a better\laim than a hose.")
    case 8:
        msgbox("{SPEAKER NAME_HIDEAKI}Back when I was younger, I used\nto have a pair of waders for fishing.\pWith a pair of those, you could just walk\nup to the pots.")
    case 9:
        msgbox("{SPEAKER NAME_HIDEAKI}Wait, are the plants in the pots\nplastic? Then they don't need water!")
        setboxframe(BOX_FRAME_TIANA)
        dynmultichoice(0, 0, TRUE, 2, 1, DYN_MULTICHOICE_CB_NONE,
                        "All plants here are real.",
                        "Too many shed leaves for that.")
        msgbox("{SPEAKER NAME_HIDEAKI}Ah, I guess I see leaves that\nhave fallen off the plants.")
    default:
        msgbox("{SPEAKER NAME_HIDEAKI}How do you even water the pots over\nthere?")
        setvar(VAR_POTTED_PLANT_MAN, 0)
    }
    addvar(VAR_POTTED_PLANT_MAN, 1)
    waitmessage
    applymovement(LOCALID_POTTED_PLANT_MAN, moves(face_left))
    waitmovement
    release
}


script Entrance_NotThisWay {
    lock
    msgbox("There is still more to uncover")
    applymovement(player, moves(walk_up))
    waitmovement
    release
}

// Xerneas - This woman is quite old
script Entrance_Morgan {
    checkbossdefeated(FINAL_BOSS_XERNEAS)
    if(var(VAR_RESULT)==FALSE){
        if(flag(FLAG_MORGAN_INTRO_CHAT)==FALSE) {
            goto(Entrance_Morgan_Introduction)
        }
        else {
            goto(Entrance_Morgan_Introduction_Followup)
        }
    }
    else {
        if(var(VAR_XERNEAS_PROGRESS)>5) {
            if(flag(FLAG_MORGAN_FALSE_ENDING_CHAT)==FALSE) {
                goto(Entrance_Morgan_XerneasFalseEnding)
            }
            else {
                goto(Entrance_Morgan_XerneasFalseEnding_Followup)
            }
        }
        else {
            if(flag(FLAG_MORGAN_TRUE_ENDING_CHAT)==FALSE){
                goto(Entrance_Morgan_XerneasTrueEnding)
            }
            else {
                goto(Entrance_Morgan_XerneasTrueEnding_Followup)
            }
        }
    }
}

script Entrance_Morgan_Introduction {
    lock
    faceplayer
    msgbox("This place is truly fascinating…\p"
            "I mean, discovering history by\nsimulating stories to find out\lwhat really happened?\p"
            "It's incredible what technology\ncan do these days.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Yup, the whole system is incredible!\p"
            "Though, I still don't really\nunderstand how it works.\lEven though I use it daily…")
    closemessage
    msgbox("Ah, so you are a recordkeeper?")
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("Since recently, yeah!")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Impressive, at such a young age too!")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("If you're interested, I could\nlet miss Satsuki know.\p"
            "We could always use more members.")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Mhm, thank you for the offer, but\nI think I'll pass.\p"
            "I'm no good with technology, and\nprefer the more traditional ways of\lstorytelling.\p"
            "You can't teach an old dog\nnew tricks, as they say…")
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Aww don't be so harsh on yourself,\nyou look hardly older than me!")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Hehee, thank you. Don't worry about\nit too much.\p"
            "But I will still have to decline.\p"
            "I won't be here for long.\nMy destination lies elsewhere.")
    closemessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Just a question for my own\ncuriosity, are you working on\lanything specifically?")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Yeah, I've been assigned a couple of\nstories.\p"
            "They were.{PAUSE 15}.{PAUSE 15}.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Ah, right. 'Overflowing Abundance',\n'The Lost Archipelago' and\l'The Original Sinner'")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("The Abundance myth, hm?\p"
            "That does sound rather fascinating.\nAs do the others.\p"
            "It sounds like you have a lot to do.\p"
            "I shan't hold you up any longer\nthen.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("Well, talking to visitors is also part\nof the job description!\p"
            "But you're right, I do have to\nget back to them.\p"
            "See you around, miss…")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Morgan.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Got it.\nTake care, miss Morgan!")
    closemessage
    setflag(FLAG_MORGAN_INTRO_CHAT)
    release
}

script Entrance_Morgan_Introduction_Followup {
    lock
    faceplayer
    msgbox("You guys truly have a lot of stories\nstored in here.\p"
            "I think I'll stick around for a\nwhile until I've read most of them.")
    closemessage
    release
}

script Entrance_Morgan_XerneasFalseEnding {
    lock
    faceplayer
    msgbox("Hey, miss Morgan! Not leaving yet,\nI see?")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Leaving? Why'd I do that?\p"
            "Right, miss Satsuki did mention that\nyou are a bit forgetful.\p"
            "I'm still far from finished converting\nall my experiences into data for\lthe archives.")
    closemessage
    msgbox(".{PAUSE 15}.{PAUSE 15}.?")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("I did see you've completed Xerneas's\ntale.\p"
            "It is just as I told you, right?")
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Sigh…\nif only things went different that day,\lI wouldn't be stuck like this.\p"
            "Oh well, I may as well make myself\nuseful while I still can.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("I… see.")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("You've got other business to attend\nto, correct?\p"
            "I think your time is better spent\narchiving your own findings, rather\lthan worrying about little old me.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Mmm, I suppose you are right.\p"
            "In that case, stay safe, miss Morgan.")
    closemessage
    setflag(FLAG_MORGAN_FALSE_ENDING_CHAT)
    release
}

script Entrance_Morgan_XerneasFalseEnding_Followup {
    lock
    faceplayer
    msgbox("Oh, Tiana. I'm managing just fine.\p"
            "But thanks for checking in.")
    closemessage
    release
}

script Entrance_Morgan_XerneasTrueEnding {
    msgbox("Good day, miss Morgan.\nHow are you doing?")
    closemessage
    faceplayer
    msgbox("I- sorry, I think you have the\nwrong person\p"
            "Also, you don't have to adress me\nwith miss. I'm not that old.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Ah, right. I… must've mistaken you\nfor someone else then")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("It's fine, it's fine. Don't stress too\nmuch about it.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Though… hmm.\nIt's funny you called me that.\p"
            "It was one of the names my parents\nwere considering to give me.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("Mhm, that's a pretty odd coincidence\p"
            "So if not Morgan, what can I call\nyou?")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Oh, you can call me Yfa!\p"
            "I should've introduced myself before\ngoing on that ramble. And you?")
    closemessage
    msgbox("Tiana.\nI'm a recordkeeper here!")
    closemessage
    msgbox("Oh, what a cute name.")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Since you work here, I actually have a\nrequest.\p"
            "Reason I'm here today and all that.\p"
            "My familiy is convinced that we are\ndescendants from the Morgan who\lhelped quell Xerneas.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Which is also why they were\nconsidering that name.\p"
            "But I feel like that's just a load\nof hot air.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Keeping up public appearance huh?")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Yeah, good way of putting it.\p"
            "Anyway, I heard you guys recently\nfinished deciphering Xerneas' tale.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("Oh hey, yeah that's right!\p"
            "It was me who did that, actually.")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Whoa, lucky me. Seems I bumped\ninto the right person.\p"
            "I read there was indeed a Morgan\namong the heroes who defeated\lXerneas.\p"
            "Do you know more about what\nhappened to her afterwards?")
    closemessage
    msgbox("Well-")
    waitmessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("The archive shows my own notes,\nI don't know more than what you\lhave already read in it.\p"
            "That said, you bear a striking\nresemblance to how she was \ldepicted.")
    closemessage
    msgbox("… I see. Hmmmm.")
    waitmessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Intriguing. That gives me something\nto think about.\p"
            "Thank you for your cooperation.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Anytime! Let me know if there's\nanything else.")
    closemessage
    msgbox("That's all for now.")
    closemessage
    msgbox("I'll be going back to work then.\nTake care Yfa!")
    closemessage
    setflag(FLAG_MORGAN_FALSE_ENDING_CHAT)
    release
}

script Entrance_Morgan_XerneasTrueEnding_Followup {
    lock
    faceplayer
    msgbox("Hey Tiana! I've decided- I'm going to join you guys here!"
            "Soon, I'll be 'Recordkeeper Yfa'")
    closemessage
    release
}

script Entrance_GetDirectionAndWalkInPlace {
    getobjectfacingdirection(VAR_TEMP_2, VAR_TEMP_3) //1: south, 2: north, 3:west, 4:east
    if(var(VAR_TEMP_3)== 1 ) {
        applymovement(VAR_TEMP_2, moves(walk_in_place_down))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 2 ){
        applymovement(VAR_TEMP_2, moves(walk_in_place_up))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 3 ){
        applymovement(VAR_TEMP_2, moves(walk_in_place_left))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 4 ){
        applymovement(VAR_TEMP_2, moves(walk_in_place_right))
        waitmovement
        return
    }
    return
}

script Entrance_GetDirectionAndJumpInPlace {
    getobjectfacingdirection(VAR_TEMP_2, VAR_TEMP_3) //1: south, 2: north, 3:west, 4:east
    if(var(VAR_TEMP_3)== 1 ) {
        applymovement(VAR_TEMP_2, moves(jump_in_place_down))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 2 ){
        applymovement(VAR_TEMP_2, moves(jump_in_place_up))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 3 ){
        applymovement(VAR_TEMP_2, moves(jump_in_place_left))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 4 ){
        applymovement(VAR_TEMP_2, moves(jump_in_place_right))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    return
}

script Entrance_GetDirectionAndLookToSide {
    getobjectfacingdirection(VAR_TEMP_2, VAR_TEMP_3) //1: south, 2: north, 3:west, 4:east
    if(var(VAR_TEMP_3)== 1 ) {
        applymovement(VAR_TEMP_2, moves(face_left, delay_16*3, face_down))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 2 ){
        applymovement(VAR_TEMP_2, moves(face_left, delay_16*3, face_up))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 3 ){
        applymovement(VAR_TEMP_2, moves(face_up, delay_16*3, face_left))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 4 ){
        applymovement(VAR_TEMP_2, moves(face_down, delay_16*3, face_right))
        waitmovement
        return
    }
    return
}

