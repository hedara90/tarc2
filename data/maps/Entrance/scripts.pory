mapscripts Entrance_MapScripts {
    MAP_SCRIPT_ON_RESUME {
        callnative(Init_PulseNeonLights)
    }
    MAP_SCRIPT_ON_TRANSITION: Entrance_OnTransition
}

const satsuki = ENTRANCE_SATSUKI
const player = OBJ_EVENT_ID_PLAYER
const morgan = ENTRANCE_MORGAN
const kenichi = ENTRANCE_KENICHI
const scilla = ENTRANCE_SCILLA
const akuwa = ENTRANCE_AKUWA
const nakamura = ENTRANCE_NAKAMURA
const hanzo = ENTRANCE_HANZO
const empress = ENTRANCE_EMPRESS
const chisa = ENTRANCE_CHISA

script Entrance_OnTransition {
    if(var(VAR_STORY) == 0) {
        setobjectxyperm(satsuki, 25, 10)
    }
    else {
        setobjectxyperm(satsuki, 32, 12)
    }
    checkbossdefeated(FINAL_BOSS_LUGIA)
    if(var(VAR_RESULT)==FALSE){
        if(flag(FLAG_KENICHI_INTRO_CHAT)==TRUE){
            setflag(FLAG_KENICHI)
        }
    }
    else {
        if(flag(FLAG_KENICHI_FALSE_ENDING_CHAT)==FALSE && var(VAR_LUGIA_PROGRESS) > 5){
            clearflag(FLAG_KENICHI)
            setobjectmovementtype(kenichi, MOVEMENT_TYPE_LOOK_AROUND)
            setobjectxyperm(kenichi, 25, 26)            
        }
        elif(flag(FLAG_KENICHI_FALSE_ENDING_CHAT)==TRUE && var(VAR_LUGIA_PROGRESS) > 5) {
            setflag(FLAG_KENICHI)
        }
        if(var(VAR_LUGIA_PROGRESS)<=5){
            clearflag(FLAG_KENICHI)
            clearflag(FLAG_KENICHI_FAMILY)
            setobjectmovementtype(kenichi, MOVEMENT_TYPE_FACE_DOWN)
            setobjectxyperm(kenichi, 29,21)
        }
    }

    checkbossdefeated(FINAL_BOSS_GIRATINA)
    if(var(VAR_RESULT)==FALSE){
        random(3)
        if(var(VAR_RESULT)== 0){
            clearflag(FLAG_EMPRESS)
        }
        else{
            setflag(FLAG_EMPRESS)
        }
    }
    else {
        if(var(VAR_GIRATINA_PROGRESS) > 5){
            setflag(FLAG_EMPRESS)
            if(flag(FLAG_MONKS_FALSE_ENDING_CHAT)==FALSE){
                    clearflag(FLAG_MONKS_HANZO)
                    setflag(FLAG_MONKS_NAKAMURA)
                }
        }
        else {
            clearflag(FLAG_EMPRESS)
            if(flag(FLAG_MONKS_TRUE_ENDING_CHAT)==FALSE){
                clearflag(FLAG_MONKS_NAKAMURA)
                setflag(FLAG_MONKS_HANZO)
                setobjectxyperm(nakamura, 10, 32)
            }
        }
    }
}

script Entrance_FirstDay_Top {
    lock
    applymovement(satsuki, moves(walk_down*2))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Good morning {PLAYER}.\pUp nice and early, hmm?")
    applymovement(player, moves(walk_right*2))
    waitmovement(player)
    goto(Entrance_FirstDay)
}

script Entrance_FirstDay_Mid {
    lock
    applymovement(satsuki, moves(walk_down*2))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Good morning {PLAYER}.\pUp nice and early, hmm?")
    applymovement(player, moves(walk_right, walk_up))
    waitmovement(player)
    goto(Entrance_FirstDay)
}

script Entrance_FirstDay_Bot {
    lock
    applymovement(satsuki, moves(walk_down*2))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Good morning {PLAYER}.\pUp nice and early, hmm?")
    applymovement(player, moves(walk_up*2))
    waitmovement(player)
    goto(Entrance_FirstDay)
}


script Entrance_FirstDay {
    closemessage
    applymovement(player, moves(walk_up*3, walk_right))
    waitmovement(player)
    applymovement(satsuki, moves(face_left))
    applymovement(player, moves(walk_in_place_right))
    msgbox("{SPEAKER NAME_PLAYER}So are you, miss Satsuki.\p"
            "You look like you just rolled out\nof bed yourself.")
    closemessage
    applymovement(satsuki, moves(face_down, delay_16*3, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}… No matter. I did say we could\nsleep in for once.\p"
            "You've … definitely taken that\nopportunity.")
    waitmessage
    applymovement(satsuki, moves(walk_right, walk_up))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}The birds have long ceased their\nmorning chatter.")
    closemessage
    applymovement(satsuki, moves(face_left))
    playse(SE_LEDGE)
    applymovement(player, moves(jump_in_place_right))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Hey hey, I don't get to celebrate\nmy graduation every day!")
    applymovement(satsuki, moves(walk_down, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Fufufu, you are right.\pI was just pulling your leg.\p"
            "So, do you still remember your\ntraining, or did all the partying\llast night muddy up your memory?")
    setboxframe(BOX_FRAME_TIANA)
    dynmultichoice(0,0, TRUE, 2, 1, DYN_MULTICHOICE_CB_NONE,
                    "Ofcourse I still remember.",
                    "Uhhh…")
    if(var(VAR_RESULT)==0){
        goto(Entrance_SatsukiIntro)
    }
    else {
        goto(Entrance_SatsukiBattle)
    }
}

script Entrance_SatsukiBattle {
    applymovement(satsuki, moves(face_up))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Honestly…\pAll that practice and studying,\nyet you still forget everything\lthe moment you graduate…")
    waitmessage
    applymovement(satsuki, moves(face_left))
    msgbox("{SPEAKER NAME_SATSUKI}It appears I have to teach\nmy student one more lesson.\pSteady yourself.")
    closemessage
    setflag(FLAG_NO_WHITEOUT)
    callnative(SetupSatsukiBattle)
    trainerbattle_no_intro(TRAINER_SATSUKI, Satsuki_After)
    switch(var(VAR_RESULT)) {
    case 0:
        msgbox("{SPEAKER NAME_SATSUKI}You never were an early bird,\nso I don't know what I expected .\p"
                "Now, let's move on. We don't have\nall day.")
    case 1:
        msgbox("{SPEAKER NAME_SATSUKI}That should cover the gaps in\nyour knowledge.\p"
                "Now, let's move on. We don't have\nall day.")
    }
    closemessage
    clearflag(FLAG_NO_WHITEOUT)
    applymovement(satsuki, moves(face_down))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Less than half a day, in fact.")
    closemessage
    applymovement(satsuki, moves(face_left))
    waitmovement(satsuki)
    goto(Entrance_StartingAnAdventure)
}

text Satsuki_After {
    "Well fought."
}

script Entrance_SatsukiIntro {
    msgbox("{SPEAKER NAME_SATSUKI}Excellent, that means you can get\nstarted right away.")
    waitmessage
    goto(Entrance_StartingAnAdventure)
}

script Entrance_StartingAnAdventure {
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_left*4, walk_diag_northwest))
    applymovement(player, moves(delay_16*2, face_left))
    waitmovement(LOCALID_CAMERA)
    msgbox("{SPEAKER NAME_SATSUKI}From now on, you can select your\nstrategy there.")
    closemessage
    applymovement(LOCALID_CAMERA, moves(walk_right*2, walk_diag_northeast*2, walk_right*3))
    applymovement(satsuki, moves(delay_16*2, face_up))
    applymovement(player, moves(delay_16*2, face_up))
    waitmovement(LOCALID_CAMERA)
    msgbox("{SPEAKER NAME_SATSUKI}Interact with the Bodhai Tree\nto enter a Myth")
    closemessage
    applymovement(LOCALID_CAMERA, moves(walk_down, walk_diag_southwest*2))
    waitmovement(LOCALID_CAMERA)
    applymovement(satsuki, moves(face_left))
    applymovement(player, moves(face_right))
    special(RemoveCameraObject)
    msgbox("{SPEAKER NAME_SATSUKI}Remember, once you're in a story,\nyou cannot receive any help\lfrom outside.\p"
            "Make sure to use all the information\nthe tree provides.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Satsuki, we've gone over this so.{PAUSE 30}\nmany.{PAUSE 30} times.{PAUSE 30}\p"
            "I got it, okay?")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Wonderful.\p"
            "As you know, the Bodhai Tree\nwrites records of what you do\lautomatically.\p"
            "And since your work will now\nbe public, I do not want to see\lany nonsense.\pUnderstood?\p"
            "I've loaded in the Myths we have\nyet to understand.\pI look forward to your\ndiscoveries.")
    closemessage
    applymovement(player, moves(walk_in_place_right))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Mhm, I'll give it my all!")
    waitmessage
    msgbox("{SPEAKER NAME_SATSUKI}Fufu, that's the spirit.\p"
            "I assume you've still got all your\nstudy notes written down in the\lterminal in your room, right?")
    applymovement(player, moves(face_down, delay_16*2, face_right))
    msgbox("{SPEAKER NAME_PLAYER}Well, I have{PAUSE 10}.{PAUSE 10}.{PAUSE 10}. most of it, yeah!\n{PAUSE 50}I think.")
    closemessage
    applymovement(satsuki, moves(walk_right*2, delay_16*2, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Oh right, one more thing.")
    waitmessage
    applymovement(satsuki, moves(face_down, delay_16*3, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}The library is now open to the public\nagain.\p"
            "Since you are now officially a\nRecordkeeper, I expect you treat\lour guests properly.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Ofcourse! I'll be on my best behaviour,\nboss!")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Good.")
    applymovement(satsuki, moves(walk_right*4))
    waitmovement(satsuki)
    setobjectxyperm(satsuki, 32, 12)
    setvar(VAR_STORY, 1)
    closemessage
    release
}

script Entrance_PickWeather {
    lock
    msgbox("Select Affinity")
    setboxframe(BOX_FRAME_PC)
    dynmultichoice(0,0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
                    "Sun",
                    "Rain",
                    "Sand",
                    "Snow",
                    "Random")
    switch(var(VAR_RESULT)) {
        case 0: setvar(VAR_TEMP_1, 0)
                goto(Entrance_PickWeather_Set)
        case 1: setvar(VAR_TEMP_1, 1)
                goto(Entrance_PickWeather_Set)
        case 2: setvar(VAR_TEMP_1, 2)
                goto(Entrance_PickWeather_Set)
        case 3: setvar(VAR_TEMP_1, 3)
                goto(Entrance_PickWeather_Set)
        case 4: setaffinity(MON_LIST_RANDOM)
                goto(Entrance_PickWeather_Exit)
    }
    closemessage
}

script Entrance_PickWeather_Set {
    msgbox("Select style")
    setboxframe(BOX_FRAME_PC)
    dynmultichoice(0,0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Grace",
                    "Favor",
                    "Prayer",)
    switch(var(VAR_RESULT)) {
        case 0: switch(var(VAR_TEMP_1)) {
            case 0: setaffinity(MON_LIST_SUN_DIRECT)
            case 1: setaffinity(MON_LIST_RAIN_DIRECT)
            case 2: setaffinity(MON_LIST_SAND_DIRECT)
            case 3: setaffinity(MON_LIST_SNOW_DIRECT)
            }
            goto(Entrance_PickWeather_Exit)
        case 1: switch(var(VAR_TEMP_1)) {
            case 0: setaffinity(MON_LIST_SUN_CONDITIONAL)
            case 1: setaffinity(MON_LIST_RAIN_CONDITIONAL)
            case 2: setaffinity(MON_LIST_SAND_CONDITIONAL)
            case 3: setaffinity(MON_LIST_SNOW_CONDITIONAL)
           }
           goto(Entrance_PickWeather_Exit)
        case 2: switch(var(VAR_TEMP_1)) {
            case 0: setaffinity(MON_LIST_SUN_MANUAL)
            case 1: setaffinity(MON_LIST_RAIN_MANUAL)
            case 2: setaffinity(MON_LIST_SAND_MANUAL)
            case 3: setaffinity(MON_LIST_SNOW_MANUAL)
           }
            goto(Entrance_PickWeather_Exit)
        }
    goto(Entrance_PickWeather)
}

script Entrance_PickWeather_Exit {
    msgbox("Affinity confirmed")
    closemessage
    release
}

script Entrance_Boss {
    msgbox("Confirm Myth to uncover.")
    setboxframe(BOX_FRAME_BODHAI)
    dynmultichoice(0,0,FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
                    "Overflowing Abundance",
                    "The Lost Archipelago",
                    "The Original Sinner",
                    "Exit")
    switch(var(VAR_RESULT)) {
        case 0: setuphunt(FINAL_BOSS_XERNEAS)
            msgbox(format("Initializing 'Overflowing Abundance'\n{PAUSE 15}. {PAUSE 15}. {PAUSE 15}."))
            goto(Entrance_BossStart)
        case 1: setuphunt(FINAL_BOSS_LUGIA)
            msgbox(format("Initializing 'The Lost Archipelago'\n{PAUSE 15}. {PAUSE 15}. {PAUSE 15}."))
            goto(Entrance_BossStart)
        case 2: setuphunt(FINAL_BOSS_GIRATINA)
            msgbox(format("Initializing 'The Original Sinner'\n{PAUSE 15}. {PAUSE 15}. {PAUSE 15}."))
            goto(Entrance_BossStart)
        case 3: closemessage
                release
    }
    closemessage
    release
}

script Entrance_BossStart {
    msgbox("Myth initialized succesfully.{PAUSE 60}\nEntering story.")
    warpsilent(MAP_MYTH_HUB, 20, 18)
}

script Entrance_Satsuki {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_SATSUKI}Hmm? Something the matter?")
    // totalmythscleared
    // if(var(VAR_RESULT) >= 2){
    //     msgbox("You've cleared 2 myths!")
    // }
    // else {
    //     msgbox("You have not cleared 2 myths")
    // }
    setboxframe(BOX_FRAME_TIANA)
    dynmultipush("Got anything new?", 0)
    // dynmultipush("Can we have another practice battle?",1)
    dynmultipush("Deciphering anything today?",2)
    dynmultipush("How did you set up the Bodhai system?",3)
    totalmythscleared
    if(var(VAR_RESULT)!=0 && flag(FLAG_SATSUKI_FIRSTMYTH)==FALSE){
        dynmultipush("I managed to clear one of the stories!",4)
    }
    if(var(VAR_RESULT)>= 2 && flag(FLAG_SATSUKI_TWOMYTHS)==FALSE){
        dynmultipush("The visitors seem... different?",5)
    }
    if(var(VAR_RESULT)>= 3 && var(VAR_GIRATINA_PROGRESS)<=5 && var(VAR_LUGIA_PROGRESS)<=5 && var(VAR_XERNEAS_PROGRESS)<=5){
        dynmultipush("I think I've finished everything!",6)
    }
    dynmultistack(0,0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    switch(var(VAR_RESULT)){
        case 0: goto(Entrance_Satsuki_AnythingNew)
        // case 1: goto(Entrance_Satsuki_MockBattle)
        case 2: goto(Entrance_Satsuki_Deciphering)
        case 3: goto(Entrance_Satsuki_Bodhai)
        case 4: goto(Entrance_Satsuki_FirstClear)
        case 5: goto(Entrance_Satsuki_Visitor)
        case 6: goto(Entrance_Satsuki_AllMyths)
    }
    closemessage
    release
}

script Entrance_Satsuki_AnythingNew {
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}You're still working on the\nassignments, aren't you?\p"
            "Focus on them first before\nasking me for more.\p"
            "History doesn't write itself.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Sigh... Fair point.\p"
            "I'll get back to work.")
    closemessage
    release
}

script Entrance_Satsuki_MockBattle {
    msgbox("{SPEAKER NAME_SATSUKI}Fufu, sure.\p"
            "Are you sure it's for practice,\nand not just because you want to win\lagainst me?\p"
            "I could use a little break anyway.")
    closemessage
    msgbox("Mock Battle Here")
    closemessage
    release
}

script Entrance_Satsuki_Deciphering {
    msgbox("{SPEAKER NAME_SATSUKI}Fufu, well that is your job now.\p"
            "I can sit back and watch you do everything now.")
    waitmessage
    delay(60)
    msgbox("{SPEAKER NAME_SATSUKI}You're too gullible.\p"
            "I am mostly leaving the decoding up to you.\p"
            "But this means I now have time for different things that must be done\p"
            "There's still many mysteries left to uncover.\p"
            "However, many of them are too incomplete to enter into the system.\p")
    closemessage
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}You remember the Archivologists, right?")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, you did mention them.\p"
            "They've got all this tech to figure out when and where something happened, right?")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}{PAUSE 15}. {PAUSE 15}. {PAUSE 15}. close enough\p"
            "But yes. They have ways of figuring out where and when a myth originated.\p"
            "That's the limit though. They can't determine the actual events.")
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}So naturally, that's where we step in.\p"
            "I've not recently had contact with them, though."
            "Elio's not been answering me, and I don't have any other direct contact points.\p"
            "Had to go through the 'Official' channels.\p"
            "I dislike all this bureaucracy.")
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Haha, yeah you never were one for strict rules.")
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_SATSUKI}Shush, I can always add more rules.\p")
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}But yeah, that's the situation."
            "Will take some time before we get anything new.\p")
}

script Entrance_Satsuki_Bodhai {
    msgbox("{SPEAKER NAME_SATSUKI}And where does this sudden interest\ncome from?\p"
            "Thought you didn't care for the\ntechnical things\p")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Think it dawned on me that I have\nto actually work with it.\p"
            "Not knowing much more than the\nbasics sounds like a bad idea,\lto be honest")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Fufu, color me surprised.\nNever thought I'd see the day.")
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}I didn't make this system on my own.\nReki helped me out.")
    playse(SE_PIN)
    applymovement(player, moves(emote_exclamation_mark))
    msgbox("{SPEAKER NAME_PLAYER}Oh, him? I thought he hated\ntechnology")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_SATSUKI}Not entirely wrong, he really\ndisliked the idea at first.\p"
            "But I eventually managed to\nconvince him.\p"
            "Got him to realize that no matter\nhow meticulous, the human mind\ncan't store infinite data.\p"
            "And neither can the human body.")
    closemessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}There was a period where he was\nconvinced he could just get rid of\nuseless memories.\p"
            "Which is an exceedingly stupid idea.\p"
            "Though knowledgable, he was also\njust a stubborn fool.")
    closemessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}Anyway, that aside. Back to the\ntopic.\p"
            "Functionally, the Bodhai system is\nnothing more than a predictive\lalgorithm."
            "A very complex one, but an\nalgorithm nonetheless.\p"
            "Basically, we enter a bunch of\nstarting info and parameters.\p"
            "After that, its essentially\njust one big simulation.\p"
            "And you're the variable factor that's\nacting as the hero.\p")
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_PLAYER}... Aha.{PAUSE 45} So it's like that.")
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_SATSUKI}It is a lot more complicated than\nthat, but we'd be here all day for\lthe detailed explanation.\p"
            "We both have better things to do.\p"
            "Besides, I don't think you'd\nenjoy the data entry.\p")
    closemessage
    delay(45)
    msgbox("{SPEAKER NAME_SATSUKI}Or that you'd be any good at it.\p")
    closemessage
    release
}

script Entrance_Satsuki_FirstClear {
    msgbox("{SPEAKER NAME_SATSUKI}I just checked the archives this\nmorning. Good work, Tiana.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Hehe, thank you! It was nice to\nsee the ending.")
    closemessage
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_SATSUKI}Good, use that momentum. Don't\nget complacent now.\p"
            "Also, just because you've cleared it\ndoesn't mean you have nothing left\lto examine.\p"
            "Remember that the length of a story\ncan influence it's outcome.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)    
    msgbox("{SPEAKER NAME_PLAYER}Yup yup, I'll have another look later.")
    closemessage
    setflag(FLAG_SATSUKI_FIRSTMYTH)
    release
}

script Entrance_Satsuki_Visitor {
    applymovement(satsuki, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_SATSUKI}Different?")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, some seem like completely\ndifferent people.")
    closemessage
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}Oh? That's interesting. Have you\ncompleted anything recently?")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, I did round up another myth yesterday")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Well, there you go.")
    closemessage
    applymovement(player, moves(emote_question_mark))
    msgbox(".{PAUSE 30}.{PAUSE 30}. ??")
    closemessage
    setflag(FLAG_SATSUKI_TWOMYTHS)
    release
}

script Entrance_Satsuki_AllMyths {
    msgbox("{SPEAKER NAME_SATSUKI}Marvelous.")
    closemessage
    applymovement(player, moves(emote_question_mark))
    msgbox("{SPEAKER NAME_PLAYER}So... now what?")
    closemessage
    setvar(VAR_TEMP_2, satsuki)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_SATSUKI}Well, I have nothing for you at the\nmoment.\p"
            "Nothing new's come in.\p"
            "If you're eager for more, maybe\ncontact the Archivologists.\p"
            "Maybe you can help them out.\p")
    closemessage
    release
}

script Entrance_PlayerTerminal {
    lock
    if(var(VAR_STORY)== 0){
        msgbox("{SPEAKER NAME_PLAYER}Im running late, I don't have time\nto review anything right now!")
        goto(Entrance_PlayerTerminal_Exit)
    }
    msgbox("{SPEAKER NAME_PLAYER}Time for another review...")
    closemessage
    setboxframe(BOX_FRAME_PC)
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Story structure",
                    "Battle mechanics",
                    "Affinity",
                    "Exit")
    switch(var(VAR_RESULT)){
        case 0: goto(Entrance_PlayerTerminal_Story)
        case 1: goto(Entrance_PlayerTerminal_Battle)
        case 2: goto(Entrance_PlayerTerminal_Affinity)
        case 3: goto(Entrance_PlayerTerminal_Exit)
    }
    goto(Entrance_PlayerTerminal_Exit)
}

script Entrance_PlayerTerminal_Exit {
    closemessage
    release
}

script Entrance_PlayerTerminal_Story {
    msgbox("Hmm... I think I had my notes on the\nrecording process here.")
    dynmultichoice(0, 0, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE,
                    "General structure",
                    "Initializing Pokémon",
                    "Obtaining moves",
                    "Gaining abilities",
                    "Leaving a story",
                    "Back")
    switch(var(VAR_RESULT)){
        case 0: msgbox(Entrance_Text_Structure)
            goto(Entrance_PlayerTerminal_Story)
        case 1: msgbox(Entrance_Text_Pokemon)
            goto(Entrance_PlayerTerminal_Story)
        case 2: msgbox(Entrance_Text_Moves)
            goto(Entrance_PlayerTerminal_Story)
        case 3: msgbox(Entrance_Text_Abilities)
            goto(Entrance_PlayerTerminal_Story)
        case 4: msgbox()
        case 5: goto(Entrance_PlayerTerminal)
    }
    goto(Entrance_PlayerTerminal)
}

text Entrance_Text_Structure {
    "The Bodhai system creates a similar\nstructure for each myth.\p"
    "Select a myth to examine.\nThe system will create a boss\lassociated with the myth.\p"
    "It will also generate 9 subdomains.\p"
    "Each domain contains a single\npowerful opponent, as well as\la number of weaker enemies.\p"
    "They represent the obstacles\nthe protagonists had to overcome.\p"
    "The final boss can be challenged\nat any time.\p"
    "Depending on the number of\nsubdomains entered, the story may\lreach different conclusions."
}

text Entrance_Text_Pokemon {
    "I can bring 3 Pokémon into\na myth.\p"
    "They are initialized via the\nBodhai system.\p"
    "There are no levels, but they\ncan become stronger through\lother means."
}

text Entrance_Text_Moves {
    format("The Pokémon I start off with know 2 moves.\p"
    "Defeating a minor enemy in a subdomain rewards a move.\p"
    "This move can be assigned to a Pokémon via the Pokémon menu.\p"
    "Select the move and press {A_BUTTON} to assign it to the currently viewed Pokémon.\p"
    "To remove an assigned move, select it and press {A_BUTTON}.\p"
    "Any move can be put onto any Pokémon, and starting moves can also be switched around.\p"
    "Lastly, rewarded moves also increase the Pokémon's stats.")
}

text Entrance_Text_Abilities {
    format("Pokemon initialized by the Bodhai Tree start with a single ability.\p"
    "Unlike starting moves, this ability is not removable.\p"
    "Defeating the boss in a subdomain rewards an ability.\p"
    "Obtained abilities can be assigned to any Pokémon, and swapped at will.")
}

text Entrance_Text_Forfeit {
    format("I can leave a story at any moment, but I will not be able to return if I do that.\p"
            "Holding {L_BUTTON} and {R_BUTTON} at the same time for a few seconds gives a pop-up to leave the story.\p"
            "Also, battles can be quit out of too. Pressing {SELECT_BUTTON} will let me do that."
            "Quitting does mean losing all progress on the run.")
}

script Entrance_PlayerTerminal_Battle {
    msgbox(format("Right, the Tree's battle system is a bit different from usual battles."))
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Switching around",
                    "Backline",
                    "Phases",
                    "Cooldowns",
                    "Abilities",
                    "Stat boosts",
                    "Back")
    switch(var(VAR_RESULT)){
        case 0: msgbox(Entrance_Text_Switching)
            goto(Entrance_PlayerTerminal_Battle)
        case 1: msgbox(Entrance_Text_Backline)
            goto(Entrance_PlayerTerminal_Battle)
        case 2: msgbox(Entrance_Text_Phases)
            goto(Entrance_PlayerTerminal_Battle)
        case 3: msgbox(Entrance_Text_Cooldowns)
            goto(Entrance_PlayerTerminal_Battle)
        case 4: msgbox(Entrance_Abilities)
            goto(Entrance_PlayerTerminal_Battle)
        case 5: msgbox(Entrance_StatBoosts)
            goto(Entrance_PlayerTerminal_Battle)
        case 6: goto(Entrance_PlayerTerminal)
    }
    goto(Entrance_PlayerTerminal)
}

text Entrance_Text_Switching {
    format("Apparantly switching works like rotation battles. Never heard of them, though.\p"
    "All my Pokémon are on the field at the same time, and they can be switched without taking up a turn.\p"
    "Abilities that activate on switch-in do require the Pokémon to take a turn, though.")
}

text Entrance_Text_Backline {
    format("When not the active battler, a Pokémon will restore a bit of health every turn.\p"
    "After 3 turns of being in the back, they will start recovering negative stat drops.\p"
    "And after 5 turns, they'll heal negative status effects.\p"
    "Well, most of them.")
}

text Entrance_Text_Phases {
    format("All enemies have multiple phases.\p"
    "Dealing enough damage transitions the opponent to the next phase.\p"
    "When this happens, they cure themselves of any statuses.\p"
    "One neat trick is that if they're pushed to the next phase before they move in the turn, they flinch!")
}

text Entrance_Text_Cooldowns {
    format("Some moves and abilities have cooldowns.\p"
    "After being used, they can't be used again until a number of turns have passed.\p"
    "Moves can be used when on cooldown though, but this will hurt the user.")
}

text Entrance_Abilities {
    format("Just like my own Pokémon, enemies can also have multiple abilities.\p"
    "The longer the story goes on, the more abilities they will have...")
}

text Entrance_StatBoosts {
    format("To improve consistency, the Bodhai Tree makes stat boost levels less drastic.\p"
    "There are still six stages, but the maximum is a 2x multiplier.\p"
    "or a 0.5x for negative stat changes.")
}

script Entrance_PlayerTerminal_Affinity {
    msgbox("Oh yeah, the team archetypes")
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Archetypes",
                    "Variations",
                    "Back",)
    switch(var(VAR_RESULT)){
        case 0: msgbox(Entrance_Text_Archetypes)
            goto(Entrance_PlayerTerminal_Affinity)
        case 1: msgbox(Entrance_Text_Variations)
            goto(Entrance_PlayerTerminal_Affinity)
        case 2: goto(Entrance_PlayerTerminal)
    }
    goto(Entrance_PlayerTerminal)
}

text Entrance_Text_Archetypes {
    format("I can pick from certain presets.\p"
            "Currently, I only have access to the 4 weather types: Sun, Rain, Snow and Sand.\p"
            "Satsuki did tell me that there are more team styles, but I can't use them yet...\p"
            "Wonder what they are.")
}

text Entrance_Text_Variations {
    format("Within the archetype, I can select 3 variations.\p"
            "Grace, Favor and Prayer.\nDon't ask me why they're named that way.\p"
            "Anyway, Grace teams feature a Pokémon that automatically sets the weather via their ability.\p"
            "Favor has a setter with a more conditional setting ability, like requiring to be hit.\p"
            "Lastly, Prayer features a manual weather setter.")
}

script Entrance_Archive {
    lock
    msgbox("Welcome to the Archive.\nSelect a topic.")
    dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                    "Overflowing Abundance",
                    "The Lost Archipelago",
                    "The Original Sinner",
                    "Exit")
    switch(var(VAR_RESULT)){
        case 0:msgbox("Loading{PAUSE 15}.{PAUSE 15}.{PAUSE 15}.\p. Data retrieved.")
            goto(Entrance_Archive_Xerneas)
        case 1:msgbox("Loading{PAUSE 15}.{PAUSE 15}.{PAUSE 15}.\p. Data retrieved.")
            goto(Entrance_Archive_Lugia)
        case 2:msgbox("Loading{PAUSE 15}.{PAUSE 15}.{PAUSE 15}.\p. Data retrieved.")
            goto(Entrance_Archive_Giratina)
    }
    closemessage
    release
}

script Entrance_Archive_Xerneas {
    checkbossdefeated(FINAL_BOSS_XERNEAS)
    if(var(VAR_RESULT)==FALSE){
        fadescreen(FADE_TO_BLACK)
        openbook(PAGE_XERNEAS_UNFINISHED_1)
    }
    else {
        if(var(VAR_XERNEAS_PROGRESS) > 5){
            fadescreen(FADE_TO_BLACK) 
            openbook(PAGE_XERNEAS_FALSE_1)
        }
        else {
            fadescreen(FADE_TO_BLACK)
            openbook(PAGE_XERNEAS_TRUE_1)
        }
    }
}

script Entrance_Archive_Lugia {
    checkbossdefeated(FINAL_BOSS_LUGIA)
    if(var(VAR_RESULT)==FALSE){
        fadescreen(FADE_TO_BLACK)
        openbook(PAGE_LUGIA_UNFINISHED)
    }
    else {
        if(var(VAR_LUGIA_PROGRESS) > 5){
            fadescreen(FADE_TO_BLACK) 
            openbook(PAGE_LUGIA_FALSE_1)
        }
        else {
            fadescreen(FADE_TO_BLACK)
            openbook(PAGE_LUGIA_TRUE_1)
        }
    }
}

script Entrance_Archive_Giratina {
    checkbossdefeated(FINAL_BOSS_GIRATINA)
    if(var(VAR_RESULT)==FALSE){
        fadescreen(FADE_TO_BLACK)
        openbook(PAGE_GIRATINA_UNFINISHED_1)
    }
    else {
        if(var(VAR_GIRATINA_PROGRESS) > 5){
            fadescreen(FADE_TO_BLACK) 
            openbook(PAGE_GIRATINA_FALSE_1)
        }
        else {
            fadescreen(FADE_TO_BLACK)
            openbook(PAGE_GIRATINA_TRUE_1)
        }
    }
}

script Entrance_PrayerGirl {
    lock
    faceplayer
    callnative(CheckHasDanced)
    switch (var(VAR_RESULT)) {
    case 0:
        msgbox("{SPEAKER NAME_KIO}You're a Recordkeeper! Could you show\nme a prayer dance?")
        setboxframe(BOX_FRAME_TIANA)
        dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
                        "Sure!",
                        "Not right now.",
                        "No.")
        switch(var(VAR_RESULT)) {
        case 0:
            msgbox("{SPEAKER NAME_KIO}Yay!")
            waitmessage
            closemessage
            goto(Entrance_DoPrayerDance)
        case 1:
            msgbox("{SPEAKER NAME_KIO}I'll look forward to it!")
            waitmessage
            release
        case 2:
            msgbox("{SPEAKER NAME_KIO}Oh… Maybe I can ask again later?")
            waitmessage
            release
        }
    case 1:
        msgbox("{SPEAKER NAME_KIO}Thank you for showing me the dance!")
        waitmessage
        release
    }
}

script Entrance_DoPrayerDance {
    callnative(GetPositionForDance)
    switch(var(VAR_RESULT)) {
    case 0:
        applymovement(player, moves(walk_right, walk_down))
        waitmovement
        applymovement(LOCALID_KIO, moves(face_right))
        applymovement(player, moves(walk_right, walk_right))
        waitmovement
        release
    case 1:
        applymovement(player, moves(walk_right*2))
        waitmovement
        release
    case 2:
        applymovement(player, moves(walk_right, walk_up))
        waitmovement
        applymovement(LOCALID_KIO, moves(face_right))
        applymovement(player, moves(walk_right, walk_right))
        waitmovement
        release
    }
    callnative(SetupPrayerDance)
    setmetatile(10, 25, 0x26, TRUE)
    setmetatile(10, 26, 0x26, TRUE)
    setmetatile(10, 27, 0x26, TRUE)
    setmetatile(9, 28, 0x26, TRUE)
    setmetatile(8, 28, 0x26, TRUE)
    setmetatile(7, 28, 0x26, TRUE)
    setmetatile(6, 27, 0x26, TRUE)
    setmetatile(6, 26, 0x26, TRUE)
    setmetatile(6, 25, 0x26, TRUE)
}

script Entrance_DanceDone {
    lock
    callnative(GetPositionForDanceDone)
    switch(var(VAR_RESULT)){
    case 0:
        applymovement(player, moves(walk_right, walk_down, face_left))
        waitmovement
    case 1:
        applymovement(player, moves(walk_right, face_left))
        waitmovement
    case 2:
        applymovement(player, moves(walk_right, walk_up, face_left))
        waitmovement
    case 3:
        applymovement(player, moves(walk_down, face_left))
        waitmovement
    case 4:
        applymovement(player, moves(face_left))
        waitmovement
    case 5:
        applymovement(player, moves(walk_up, face_left))
        waitmovement
    case 6:
        applymovement(player, moves(walk_down, walk_left))
        waitmovement
    case 7:
        applymovement(player, moves(walk_left))
        waitmovement
    case 8:
        applymovement(player, moves(walk_up, walk_left))
        waitmovement
    }
    applymovement(player, moves(face_up, delay_1*3 face_right, delay_1*3,,,, face_down, delay_1*3, face_left, delay_1*3, jump_in_place_left))
    waitmovement
    applymovement(LOCALID_KIO, moves(emote_heart, jump_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_KIO}Yay! That was so cute!\pThank you!")

    setmetatile(10, 25, 0x13, FALSE)
    setmetatile(10, 26, 0xB, FALSE)
    setmetatile(10, 27, 0x13, FALSE)
    setmetatile(9, 28, 0x20A, FALSE)
    setmetatile(8, 28, 0x209, FALSE)
    setmetatile(7, 28, 0x208, FALSE)
    setmetatile(6, 27, 0x99, FALSE)
    setmetatile(6, 26, 0x91, FALSE)
    setmetatile(6, 25, 0x89, FALSE)

    release
}

script Entrance_Receptionist_Direct {
    lock
    faceplayer
    msgbox("P{SPEAKER NAME_NAOTO}lease {PLAYER}, don't walk behind the\ncounter while the library is open.\pYou should know this…")
    setboxframe(BOX_FRAME_TIANA)
    dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
                    "What if I want to hug my fav clerk?",
                    "I have to keep you on your toes somehow.")
    switch (var(VAR_RESULT)) {
    case 0:
        msgbox("{SPEAKER NAME_NAOTO}Then I'll tell Fuan you asked for her.")
        msgbox("{SPEAKER NAME_PLAYER}Aww, don't be like that. I like\nyou too!")
        msgbox("{SPEAKER NAME_NAOTO}Then show your appreciation from the\nother side of the counter.")
    case 1:
        msgbox("{SPEAKER NAME_NAOTO}You did that quite well during the\n"
               "two weeks you were practicing your\l"
               "spin throw thing.")
        msgbox("{SPEAKER NAME_PLAYER}You said you wouldn't mention\nthat again…")
        msgbox(format("{SPEAKER NAME_NAOTO}And you said you'd stay on the other side of the counter. So here we are."))
    }
    closemessage
    callnative(GetBehindCounterPos)
    applymovement(LOCALID_NAOTO, moves(face_right))
    switch (var(VAR_RESULT)) {
    case 0:
        applymovement(LOCALID_PLAYER, moves(walk_left, walk_down, walk_down))
    case 1:
        applymovement(LOCALID_PLAYER, moves(walk_left, walk_left, walk_down))
    case 2:
        applymovement(LOCALID_PLAYER, moves(walk_left, walk_left, walk_down, walk_down, walk_down))
    }
    waitmovement
    setflag(FLAG_PESTERED_NAOTO)
    release
}

script Entrance_Receptionist_Glare {
    if (flag(FLAG_PESTERED_NAOTO)) {
        lock
        applymovement(LOCALID_NAOTO, moves(face_left, emote_exclamation_mark, delay_16*2))
        waitmovement
        msgbox("{SPEAKER NAME_PLAYER}(maybe not)")
        applymovement(LOCALID_PLAYER, moves(walk_down))
        waitmovement
        applymovement(LOCALID_NAOTO, moves(face_right))
        waitmovement
        release
    }
}

script Entrance_Receptionist_Counter {
    lock
    if(flag(FLAG_PESTERED_NAOTO)) {
        msgbox("{SPEAKER NAME_NAOTO}For once you did it correctly.")
        waitmessage
        msgbox(format("{SPEAKER NAME_PLAYER}Aww, don't be like that.\p"
                      "I can behave. Besides, I brighten up the place!"))
        waitmessage
        msgbox(format("{SPEAKER NAME_NAOTO}Fine, I'll give you that at least.\p"
               "Now please go and help the library visitors."))
    }
    else {
        msgbox(format("{SPEAKER NAME_NAOTO}Hello {PLAYER}, the library is now open, please go check if there are any vistors who need any help."))
        waitmessage
        msgbox("{SPEAKER NAME_PLAYER}Okay! I'll be right on it!")
        waitmessage
        msgbox(format("{SPEAKER NAME_NAOTO}…"))
        waitmessage
        msgbox("{SPEAKER NAME_PLAYER}What? I mean it!")
        msgbox("{SPEAKER NAME_NAOTO}I'll believe it when I see it.")
    }
    waitmessage
    release
}

script Entrance_ShowCredits {
    callnative(DisplayCredits)
    waitstate
    release
    end
}

script Entrance_PottedPlantMan {
    lock
    faceplayer
    switch (var(VAR_POTTED_PLANT_MAN)) {
    case 1:
        msgbox("{SPEAKER NAME_HIDEAKI}Do people jump over to the platform?")
    case 2:
        msgbox("{SPEAKER NAME_HIDEAKI}Or is there a watering can with a\nreally long pipe?")
    case 3:
        msgbox("{SPEAKER NAME_HIDEAKI}Or does someone here have really\ngood aim with a hose?")
    case 4:
        msgbox("{SPEAKER NAME_HIDEAKI}They could maybe grab the pots with\nwith something and lift them over\lto their side…")
    case 5:
        msgbox("{SPEAKER NAME_HIDEAKI}Or they could throw water balloons\nat the pots.\pNo, that would be stupid.")
    case 6:
        msgbox("{SPEAKER NAME_HIDEAKI}You know those claw machines in\narcades?")
        setboxframe(BOX_FRAME_TIANA)
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
                        "Yes?",
                        "And that's relevant, how?")
        msgbox("{SPEAKER NAME_HIDEAKI}What if there's one of those in the\nroof that picks up the pots and\lbrings it over?")
        msgbox("{SPEAKER NAME_PLAYER}(How does he even come up with\nall these ideas?)")
    case 7:
        msgbox("{SPEAKER NAME_HIDEAKI}They could have some Water type\nPokémon, they probably have a better\laim than a hose.")
    case 8:
        msgbox("{SPEAKER NAME_HIDEAKI}Back when I was younger, I used\nto have a pair of waders for fishing.\pWith a pair of those, you could just walk\nup to the pots.")
    case 9:
        msgbox("{SPEAKER NAME_HIDEAKI}Wait, are the plants in the pots\nplastic? Then they don't need water!")
        setboxframe(BOX_FRAME_TIANA)
        dynmultichoice(0, 0, TRUE, 2, 1, DYN_MULTICHOICE_CB_NONE,
                        "All plants here are real.",
                        "Too many shed leaves for that.")
        msgbox("{SPEAKER NAME_HIDEAKI}Ah, I guess I see leaves that\nhave fallen off the plants.")
    default:
        msgbox("{SPEAKER NAME_HIDEAKI}How do you even water the pots over\nthere?")
        setvar(VAR_POTTED_PLANT_MAN, 0)
    }
    addvar(VAR_POTTED_PLANT_MAN, 1)
    waitmessage
    applymovement(LOCALID_POTTED_PLANT_MAN, moves(face_left))
    waitmovement
    release
}


script Entrance_NotThisWay {
    lock
    msgbox("There is still more to uncover")
    applymovement(player, moves(walk_up))
    waitmovement
    release
}

// Xerneas - This woman is quite old
script Entrance_Morgan {
    checkbossdefeated(FINAL_BOSS_XERNEAS)
    if(var(VAR_RESULT)==FALSE){
        if(flag(FLAG_MORGAN_INTRO_CHAT)==FALSE) {
            goto(Entrance_Morgan_Introduction)
        }
        else {
            goto(Entrance_Morgan_Introduction_Followup)
        }
    }
    else {
        if(var(VAR_XERNEAS_PROGRESS)>5) {
            if(flag(FLAG_MORGAN_FALSE_ENDING_CHAT)==FALSE) {
                goto(Entrance_Morgan_XerneasFalseEnding)
            }
            else {
                goto(Entrance_Morgan_XerneasFalseEnding_Followup)
            }
        }
        else {
            if(flag(FLAG_MORGAN_TRUE_ENDING_CHAT)==FALSE){
                goto(Entrance_Morgan_XerneasTrueEnding)
            }
            else {
                goto(Entrance_Morgan_XerneasTrueEnding_Followup)
            }
        }
    }
}

script Entrance_Morgan_Introduction {
    lock
    faceplayer
    msgbox("This place is truly fascinating…\p"
            "I mean, discovering history by\nsimulating stories to find out\lwhat really happened?\p"
            "It's incredible what technology\ncan do these days.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yup, the whole system is incredible!\p"
            "Though, I still don't really\nunderstand how it works.\lEven though I use it daily…")
    closemessage
    msgbox("Ah, so you are a recordkeeper?")
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Since recently, yeah!")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Impressive, at such a young age too!")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}If you're interested, I could\nlet miss Satsuki know.\p"
            "We could always use more members.")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Mhm, thank you for the offer, but\nI think I'll pass.\p"
            "I'm no good with technology, and\nprefer the more traditional ways of\lstorytelling.\p"
            "You can't teach an old dog\nnew tricks, as they say…")
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Aww don't be so harsh on yourself,\nyou look hardly older than me!")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("Hehee, thank you. Don't worry about\nit too much.\p"
            "But I will still have to decline.\p"
            "I won't be here for long.\nMy destination lies elsewhere.")
    closemessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Just a question for my own\ncuriosity, are you working on\lanything specifically?")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, I've been assigned a couple of\nstories.\p"
            "They were.{PAUSE 15}.{PAUSE 15}.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_PLAYER}Ah, right. 'Overflowing Abundance',\n'The Lost Archipelago' and\l'The Original Sinner'")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("The Abundance myth, hm?\p"
            "That does sound rather fascinating.\nAs do the others.\p"
            "It sounds like you have a lot to do.\p"
            "I shan't hold you up any longer\nthen.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Well, talking to visitors is also part\nof the job description!\p"
            "But you're right, I do have to\nget back to them.\p"
            "See you around, miss…")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_MORGAN}Morgan.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Got it.\nTake care, miss Morgan!")
    closemessage
    setflag(FLAG_MORGAN_INTRO_CHAT)
    release
}

script Entrance_Morgan_Introduction_Followup {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_MORGAN}You guys truly have a lot of stories\nstored in here.\p"
            "I think I'll stick around for a\nwhile until I've read most of them.")
    closemessage
    release
}

script Entrance_Morgan_XerneasFalseEnding {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_PLAYER}Hey, miss Morgan! Not leaving yet,\nI see?")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_MORGAN}Leaving? Why'd I do that?\p"
            "Right, miss Satsuki did mention that\nyou are a bit forgetful.\p"
            "I'm still far from finished converting\nall my experiences into data for\lthe archives.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}.{PAUSE 15}.{PAUSE 15}.?")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_MORGAN}I did see you've completed Xerneas's\ntale.\p"
            "It is just as I told you, right?")
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_MORGAN}Sigh…\nif only things went different that day,\lI wouldn't be stuck like this.\p"
            "Oh well, I may as well make myself\nuseful while I still can.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}I… see.")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_MORGAN}You've got other business to attend\nto, correct?\p"
            "I think your time is better spent\narchiving your own findings, rather\lthan worrying about little old me.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_PLAYER}Mmm, I suppose you are right.\p"
            "In that case, stay safe, miss Morgan.")
    closemessage
    setflag(FLAG_MORGAN_FALSE_ENDING_CHAT)
    release
}

script Entrance_Morgan_XerneasFalseEnding_Followup {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_MORGAN}Oh, Tiana. I'm managing just fine.\p"
            "But thanks for checking in.")
    closemessage
    release
}

script Entrance_Morgan_XerneasTrueEnding {
    msgbox("{SPEAKER NAME_PLAYER}Good day, miss Morgan.\nHow are you doing?")
    closemessage
    faceplayer
    msgbox("I- sorry, I think you have the\nwrong person\p"
            "Also, you don't have to adress me\nwith miss. I'm not that old.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_PLAYER}Ah, right. I… must've mistaken you\nfor someone else then")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("It's fine, it's fine. Don't stress too\nmuch about it.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("Though… hmm.\nIt's funny you called me that.\p"
            "It was one of the names my parents\nwere considering to give me.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Mhm, that's a pretty odd coincidence\p"
            "So if not Morgan, what can I call\nyou?")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_YFA}Oh, you can call me Yfa!\p"
            "I should've introduced myself before\ngoing on that ramble. And you?")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Tiana.\nI'm a recordkeeper here!")
    closemessage
    msgbox("{SPEAKER NAME_YFA}Oh, what a cute name.")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_YFA}Since you work here, I actually have a\nrequest.\p"
            "Reason I'm here today and all that.\p"
            "My familiy is convinced that we are\ndescendants from the Morgan who\lhelped quell Xerneas.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_YFA}Which is also why they were\nconsidering that name.\p"
            "But I feel like that's just a load\nof hot air.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Keeping up public appearance huh?")
    closemessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_YFA}Yeah, good way of putting it.\p"
            "Anyway, I heard you guys recently\nfinished deciphering Xerneas' tale.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Oh hey, yeah that's right!\p"
            "It was me who did that, actually.")
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_YFA}Whoa, lucky me. Seems I bumped\ninto the right person.\p"
            "I read there was indeed a Morgan\namong the heroes who defeated\lXerneas.\p"
            "Do you know more about what\nhappened to her afterwards?")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Well-")
    waitmessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_PLAYER}The archive shows my own notes,\nI don't know more than what you\lhave already read in it.\p"
            "That said, you bear a striking\nresemblance to how she was \ldepicted.")
    closemessage
    msgbox("{SPEAKER NAME_YFA}… I see. Hmmmm.")
    waitmessage
    setvar(VAR_TEMP_2, morgan)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_YFA}Intriguing. That gives me something\nto think about.\p"
            "Thank you for your cooperation.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Anytime! Let me know if there's\nanything else.")
    closemessage
    msgbox("{SPEAKER NAME_YFA}That's all for now.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}I'll be going back to work then.\nTake care Yfa!")
    closemessage
    setflag(FLAG_MORGAN_FALSE_ENDING_CHAT)
    release
}

script Entrance_Morgan_XerneasTrueEnding_Followup {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_YFA}Hey Tiana! I've decided- I'm going to join you guys here!"
            "Soon, I'll be 'Recordkeeper Yfa'")
    closemessage
    release
}

//Lugia - Sailor who goes to find the archipelago. Starts off in a bad situation. Basically down on his luck, nothing left, sent on what is effetcively a suicide exploration
//false ending: Same sailor, but now he's married and in a better situation. Turns out the woman he's married to is (a descendant of) one of the people who escaped
//true ending: Brother is finally living the good life(or at least better). He and his family now live on the archipelago, and he's come here to show his wife and kids around
script Entrance_Kenichi {
    checkbossdefeated(FINAL_BOSS_LUGIA)
    if(var(VAR_RESULT)==FALSE){
        if(flag(FLAG_KENICHI_INTRO_CHAT)==FALSE){
            goto(Entrance_Kenichi_Introduction)
        }
        else {
            goto(Entrance_Kenichi_Intro_Followup)
        }
    }
    else {
        if(var(VAR_LUGIA_PROGRESS) > 5){
            if(flag(FLAG_KENICHI_FALSE_ENDING_CHAT)==FALSE){
                goto(Entrance_Kenichi_FalseEnding)
            }
            // else {
            //     goto(Entrance_Kenichi_FalseEnding_Followup)
            // }
        }
        else{
            if(flag(FLAG_KENICHI_TRUE_ENDING_CHAT)==FALSE){
                goto(Entrance_Kenichi_TrueEnding)
            }
            else {
                goto(Entrance_Kenichi_TrueEnding_Followup)
            }
        }
    }
}

script Entrance_Kenichi_Introduction {
    lock
    msgbox("Hmmm...\nHow does this even work...")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Heya! Looking for something, mister?")
    closemessage
    playse(SE_PIN)
    applymovement(kenichi, moves(emote_exclamation_mark, delay_16, face_down))
    waitmovement(kenichi)
    msgbox("Whoa, don't startle me like that!\p"
            "You shouldn't just sneak up\non someone.\p"
            "What if they would lash out at you!?")
    closemessage
    applymovement(player, moves(face_right, delay_16*2, face_left, delay_16*2, face_up))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Sir this is a library, not a\nfighting ring.\p"
            "Are you okay?")
    closemessage
    msgbox("...sigh. {PAUSE 30} Yeah, I'm fine.\p"
            "I'm not used to...")
    waitmessage
    applymovement(kenichi, moves(face_right, delay_16, face_left, delay_16, face_down))
    msgbox("All this.\p"
            "I uh- Wait, do you work here?")
    closemessage
    applymovement(player, moves(walk_in_place_up))
    msgbox("{SPEAKER NAME_PLAYER}I do work here, yeah.\p"
            "Do you need help with anything?\p"
            "(Why didn't he just ask the guys at\nthe info desk?)")
    closemessage
    playse(SE_PIN)
    applymovement(kenichi, moves(emote_exclamation_mark))
    msgbox("Oh no no, I'm fine! You don't\nhave to do anything for me!\p"
            "I can't afford that.")
    closemessage
    applymovement(player, moves(emote_question_mark))
    msgbox("{SPEAKER NAME_PLAYER}Have you... ever been to\na library?\p"
            "You won't get charged here for\njust asking me to help.")
    closemessage
    delay(30)
    applymovement(kenichi, moves(walk_in_place_down))
    msgbox("...Okay. You sure?")
    waitmessage
    applymovement(kenichi, moves(face_up, delay_16*3, face_down))
    waitmovement(kenichi)
    msgbox("I'll take your word for it then.\p"
            "I've been sent here to find stuff about\nthe Everlasting Storm.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Oh, sure, I can show you how to find it.\p"
            "Here, this way.")
    closemessage
    applymovement(player, moves(walk_right*2, face_up))
    applymovement(kenichi, moves(walk_slow_down, face_right, delay_16, walk_right))
    waitmovement(kenichi)
    msgbox("{SPEAKER NAME_PLAYER}Okay, pay attention.\p"
            "So, in the main terminal you see this\nbox which says 'search'?\p"
            "You just tap the projection there.")
    waitmessage
    applymovement(player, moves(face_left))
    msgbox("{SPEAKER NAME_PLAYER}After that, you can enter what\nyou're looking for.")
    closemessage
    applymovement(kenichi, moves(walk_in_place_right))
    msgbox("Oh, that seems quite simple,\nI think.")
    closemessage
    applymovement(player, moves(face_up))
    msgbox("{SPEAKER NAME_PLAYER}Allright, let me see...\p"
            "'Everlasting storm'{PAUSE 15}. {PAUSE 15}. {PAUSE 15}.\p"
            "Sweet, there's info about it.")
    closemessage
    applymovement(kenichi, moves(walk_in_place_right))
    msgbox("Can I have a closer look?")
    closemessage
    applymovement(player, moves(face_left))
    msgbox("{SPEAKER NAME_PLAYER}Yep! Go ahead.")
    applymovement(player, moves(lock_facing_direction, walk_right, unlock_facing_direction))
    waitmovement(player)
    applymovement(kenichi, moves(walk_right, face_up))
    waitmovement(kenichi)
    delay(60)
    playSE(SE_PIN)
    applymovement(kenichi, moves(emote_exclamation_mark))
    msgbox("Amazing, this looks like what I need!\p"
            "'The Lost Archipelago.'\nSo that's what you call it...")
    applymovement(kenichi, moves(face_right))
    msgbox("Thank you, lass. Means a lot to me.")
    closemessage
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}No worries, let me know if you have\nany more troubles!")
    closemessage
    applymovement(kenichi, moves(walk_in_place_right))
    msgbox("Hmm, I might take you up on that.\p"
            "I do have ma-")
    applymovement(kenichi, moves(face_down, delay_16*2, face_right))
    waitmovement(kenichi)
    msgbox("Nevermind.")
    applymovement(kenichi, moves(face_up))
    msgbox("Okay, lets see...")
    setobjectmovementtype(kenichi, MOVEMENT_TYPE_FACE_UP)
    setobjectxyperm(kenichi, 38, 26)
    setflag(FLAG_KENICHI_INTRO_CHAT)
    closemessage
    release
}


script Entrance_Kenichi_Intro_Followup {
    lock
    msgbox("{SPEAKER NAME_KENICHI}400 years... Never-ending winds.\nLightning strikes, dark clouds.\lProbably cursed by some deity.\p"
            "Dang, it really is the whole package.\p"
            "Kenichi, what did you get yourself in to...")
    closemessage
    release
}

script Entrance_Kenichi_FalseEnding {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_KENICHI}Hoy Tiana!\nHow's it going today?")
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}You seem a lot happier than\na couple days ago, mister!\p"
            "Something good happen?")
    closemessage
    applymovement(kenichi, moves(emote_exclamation_mark))
    msgbox("{SPEAKER NAME_KENICHI}Huh? I was still at sea 'till this morning.\p"
            "All that decodin' got your thoughts\nscrambled, lass?\p"
            "Last we spoke was about a month ago!")
    closemessage
    setvar(VAR_TEMP_2, kenichi)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_KENICHI}An'way. I just wanted to drop by 'n\nthank you lot for having all those\ldetails on the sunken archipelago.\p"
            "Ya did a great job with your\ndecoding work.\p"
            "And good timing, too!\p"
            "Can't believe ya managed that in just\na few days before we set sail.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, no problem.\n{PAUSE 60}(I think?)")
    closemessage
    setvar(VAR_TEMP_2, kenichi)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_KENICHI}Without your efforts, we would still\nbe sailing aimlessly!\p"
            "I like being at sea, but a man can't\nlive a life there.")
    closemessage
    playse(SE_PIN)
    applymovement(player, moves(emote_exclamation_mark))
    msgbox("{SPEAKER NAME_PLAYER}Wait, you managed to confirm the\nlocation? How?")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_KENICHI}I wouldn't say 'tis confirmed, but we\nhauled up a lot of artefacts from\lthe seafloor.\p"
            "No less thanks to my buddy Lanturn.\p"
            "Illuminating the sea floor's really\nuseful when you are looking for\lsunken things.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, that's not hard to imagine.")
    closemessage
    setvar(VAR_TEMP_2, kenichi)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_KENICHI}Dropped off most of it at the\nArchivologists after docking.\p"
            "Knowing them, we'll likely be heading\nback there soon.")
    waitmessage
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_KENICHI}I'm off now back home.\p"
            "I'm sure the missus wants to see her\nKenichi again.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Haha... Well then Kenichi, enjoy\nyour day.")
    closemessage
    getobjectfacingdirection(kenichi, VAR_TEMP_3)
    if(var(VAR_RESULT)==1){
        applymovement(kenichi, moves(walk_fast_right, walk_fast_down*8))
    }
    else {
        applymovement(kenichi, moves(walk_fast_down*8))
    }
    waitmovement(kenichi)
    msgbox("{SPEAKER NAME_PLAYER}(That is NOT the same person.\nWhat happened to him?)\p"
            "(Something's not adding up.)")
    setflag(FLAG_KENICHI)
    setflag(FLAG_KENICHI_FALSE_ENDING_CHAT)
    removeobject(kenichi)
    closemessage
    release
}

script Entrance_Kenichi_TrueEnding {
    lock
    msgbox("{SPEAKER NAME_KENICHI}Tiana! Good to see ya.")
    closemessage
    applymovement(player,moves(face_up))
    msgbox("{SPEAKER NAME_PLAYER}Hey Kenichi. Got company today?")
    closemessage
    applymovement(kenichi, moves(walk_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_KENICHI}Aye, got the wife 'n kid with\nme today")
    closemessage
    applymovement(kenichi, moves(face_right))
    waitmovement
    msgbox("{SPEAKER NAME_KENICHI}Scilla, you've met her before,\nright?")
    closemessage
    applymovement(scilla, moves(face_left))
    msgbox("{SPEAKER NAME_SCILLA}Yeah, we've met.\nTiana, correct?")
    closemessage
    playse(SE_LEDGE)
    applymovement(player, moves(jump_in_place_up))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Yep! Ple-\p"
            "(Hmm...)")
    closemessage
    playse(SE_LEDGE)
    applymovement(akuwa, moves(jump_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_AKUWA}Hey miss! My name is Akuwa!")
    closemessage
    applymovement(player, moves(face_left))
    applymovement(kenichi, moves(face_left))
    msgbox("{SPEAKER NAME_PLAYER}Hello there!\nI'm Tiana, nice to meet you.\p"
            "Is this your first time here?")
    playse(SE_LEDGE)
    applymovement(akuwa, moves(jump_in_place_right))
    msgbox("{SPEAKER NAME_AKUWA}Yes! Papa said he wanted to show me\nthis awesome place!")
    closemessage
    applymovement(scilla, moves(walk_in_place_left))
    applymovement(kenichi, moves(face_right))
    applymovement(player, moves(face_up))
    waitmovement(scilla)
    msgbox("{SPEAKER NAME_SCILLA}Sigh... your enthusiam's rubbing off\non her.")
    waitmessage
    applymovement(scilla, moves(face_down))
    applymovement(kenichi, moves(face_down))
    msgbox("{SPEAKER NAME_SCILLA}He can't shut up about how cool this\nplace is.\p"
            "You'd almost think he wants to work\nhere, rather than at sea.\p"
            "I'll admit, what you guys do here\nis pretty impressive.")
    closemessage
    playse(SE_PIN)
    applymovement(kenichi, moves(emote_exclamation_mark, face_right))
    waitmovement
    msgbox("{SPEAKER NAME_KENICHI}AHA!\nSo you DO find it cool!")
    closemessage
    applymovement(scilla, moves(face_left))
    msgbox("{SPEAKER NAME_SCILLA}I never said it wasn't interesting!")
    closemessage
    applymovement(scilla, moves(face_down))
    applymovement(kenichi, moves(face_down))
    applymovement(player, moves(emote_heart))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Pfft. I'm glad you guys see us\nin such a positive light.")
    waitmessage
    applymovement(player, moves(lock_facing_direction, walk_down, unlock_facing_direction))
    msgbox("{SPEAKER NAME_PLAYER}Kenichi, is there anything you want\nme to look at?")
    closemessage
    applymovement(kenichi, moves(walk_in_place_down))
    msgbox("{SPEAKER NAME_KENICHI}Mmm... Well, ever since ya figured\nout the history of Lugia, I don't got\nany personal requests")
    applymovement(kenichi, moves(face_right, delay_16*4, face_down))
    waitmovement
    msgbox("{SPEAKER NAME_KENICHI}'tis nice that that's figured out now,\nthough.\p"
            "Wanted to know the history before I\nmoved to the archipelago.\p"
            "A man's gotta appreciate his woman's\nculture after all!")
    applymovement(scilla, moves(face_left))
    msgbox("{SPEAKER NAME_SCILLA}You really do not have a filter, do you.\p"
            "Part of your charm, hah.")
    applymovement(kenichi, moves(face_right))
    msgbox("{SPEAKER NAME_KENICHI}Thanks, honey.")
    applymovement(kenichi, moves(face_down))
    applymovement(scilla, moves(face_down))
    msgbox("{SPEAKER NAME_KENICHI}But I don't got anything for ya today.\p"
            "Have requested some time off.")
    waitmessage
    applymovement(kenichi, moves(face_left))
    msgbox("{SPEAKER NAME_KENICHI}Kiddo's big enough now, so I wanted to\nshow her 'round the old place.\p"
            "First time she's off the island as well.")
    closemessage
    playse(SE_LEDGE)
    applymovement(akuwa, moves(jump_in_place_right))
    applymovement(player, moves(face_left))
    msgbox("{SPEAKER NAME_AKUWA}This place is really big! And has\nso many lights!\p"
            "Also, Mama's been helping me read\nthrough some of the stories here!\p"
            "I don't really understand them.")
    closemessage
    applymovement(player, moves(face_up))
    msgbox("{SPEAKER NAME_PLAYER}Sounds like everything is fine, then.\nI'll let you enjoy your day!\p"
            "Gotta go back to work...")
    closemessage
    applymovement(kenichi, moves(walk_in_place_down))
    msgbox("{SPEAKER NAME_KENICHI}Aye, don' let me hold you up.\p"
            "Attagirl!")
    closemessage
    applymovement(scilla, moves(walk_in_place_down))
    msgbox("{SPEAKER NAME_SCILLA}Keep up the good work, Tiana")
    closemessage
    playse(SE_LEDGE)
    applymovement(akuwa, moves(jump_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_AKUWA}Bye-bye, miss!")
    setflag(FLAG_KENICHI_TRUE_ENDING_CHAT)
    closemessage
    release
}

script Entrance_Kenichi_TrueEnding_Followup {
    msgbox("{SPEAKER NAME_KENICHI}Inform me if anything cool is\ndiscovered, okay?", MSGBOX_NPC)
}

script Entrance_Scilla {
    msgbox("{SPEAKER NAME_SCILLA}It's great to see Akuwa's inherited\nthe same interest as her father.\p"
            "The library near our house is not big\nenough for her curiosity, though.", MSGBOX_NPC)
}

script Entrance_Akuwa {
    lock
    msgbox("{SPEAKER NAME_AKUWA}Miss, what is all the water for?")
    closemessage
    applymovement(player, moves(walk_in_place_left))
    msgbox("{SPEAKER NAME_PLAYER}Oh, it uh- it keeps the place cool.\p"
            "And also, it's very calming!")
    closemessage
    playse(SE_LEDGE)
    applymovement(akuwa, moves(jump_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_AKUWA}Okay!")
    closemessage
    release
}

script Entrance_Monks {
    checkbossdefeated(FINAL_BOSS_GIRATINA)
    if(var(VAR_RESULT)==FALSE){
        goto(Entrance_Monks_Intro)
    }
    else {
        if(var(VAR_GIRATINA_PROGRESS)>5) {
            goto(Entrance_Monks_FalseEnding)
        }
        else {
            goto(Entrance_Monks_TrueEnding)
        }
    }
}

script Entrance_Monks_Intro {
    lock
    applymovement(nakamura, moves(walk_in_place_left))
    msgbox("{SPEAKER NAME_NAKAMURA}C'mon, hurry up Hanzo.\nNo time to lose.")
    closemessage
    applymovement(hanzo, moves(face_right))
    msgbox("{SPEAKER NAME_HANZO}Be quiet for once, Nakimura.\p"
            "For Arceus's sake, I cannnot\nconcentrate with you yelling in my\lear.")
    closemessage
    applymovement(hanzo, moves(face_up))
    msgbox("{SPEAKER NAME_HANZO}.{PAUSE 45}.{PAUSE 45}.{PAUSE 45} There are some results at least.")
    closemessage
    applymovement(nakamura, moves(walk_in_place_left))
    msgbox("{SPEAKER NAME_NAKAMURA}Soo.{PAUSE 30}.{PAUSE 30}?")
    closemessage
    applymovement(hanzo, moves(walk_in_place_right))
    msgbox("{SPEAKER NAME_HANZO}Man you know what, do it yourself.\p"
            "I never wanted to be here anyway.\p"
            "We know everything we need to about\nthe Distortion World.\p"
            "Why did they have to send us here.\p"
            "We could've already departed!")
    closemessage
    call(Entrance_Monks_MovementScript)
    removeobject(hanzo)
    setflag(FLAG_MONKS_HANZO)
    msgbox("{SPEAKER NAME_PLAYER}Is uh. Is he okay?\n"
            "You both seem pretty on edge.")
    closemessage
    applymovement(nakamura, moves(face_down))
    msgbox("{SPEAKER NAME_NAKAMURA}I mean yeah,who wouldn't be.\p"
            "Empress is stuck again. Not in the\nbest place.\p"
            "Girl's a piece of work to keep around\nI can tell ya that much.")
    closemessage
    applymovement(player, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Huh?")
    closemessage
    applymovement(nakamura, moves(emote_exclamation_mark))
    waitmovement
    msgbox("{SPEAKER NAME_NAKAMURA}Oh- Oh no, please forget I said\nanything.\p"
            "You were NOT meant to hear that.")
    waitmessage
    applymovement(nakamura, moves(face_right, delay_16*3, face_down))
    waitmovement
    msgbox("{SPEAKER NAME_NAKAMURA}Argh, can this day get ANY worse.")
    closemessage
    applymovement(player, moves(jump_in_place_up))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}I didn't hear anything, sir.")
    waitmessage
    applymovement(player, moves(face_right, delay_16*3, face_up))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Anyway, you two seemed to be\ntroubled by something.\p"
            "Looks like I was right on the\nmoney.\p"
            "Can I do anything for ya?")
    closemessage
    applymovement(nakamura, moves(walk_in_place_down))
    msgbox("{SPEAKER NAME_NAKAMURA}Mmm. I assume you are a\nRecordkeeper, then?\p"
            "Do you have any more info\non Giratina?")
    waitmessage
    applymovement(nakamura, moves(walk_left, face_up))
    msgbox("{SPEAKER NAME_NAKAMURA}Like, things not in the archive here.")
    closemessage
    applymovement(nakamura, moves(face_down))
    waitmovement(nakamura)
    applymovement(player, moves(walk_up, face_left))
    applymovement(nakamura, moves(face_right))
    msgbox("{SPEAKER NAME_PLAYER}I'm afraid not.")
    waitmessage
    applymovement(player, moves(jump_in_place_left))
    msgbox("{SPEAKER NAME_PLAYER}Buuut I am currently working on\ndecyphering 'The Original Sinner'.\p"
            "No guarantee on when that's\nfinished, though.")
    closemessage
    applymovement(nakamura, moves(face_down, delay_16*3, face_up, delay_16*2, face_right))
    waitmovement
    msgbox("{SPEAKER NAME_NAKAMURA}Hum. I see...\p"
            "Well, I hope you'll get it done soon.")
    closemessage
    applymovement(player, moves(walk_in_place_left))
    msgbox("{SPEAKER NAME_PLAYER}I'll try my best, sir.")
    closemessage
    applymovement(nakamura, moves(face_up, delay_16*3, face_right))
    msgbox("{SPEAKER NAME_NAKAMURA}Man, I was hoping we'd get more out\nof this trip.\p"
            "Guess that's it. Time to head back.")
    closemessage
    applymovement(nakamura, moves(walk_down, walk_right*3))
    applymovement(player, moves(delay_16, face_down, delay_16, face_right))
    waitmovement
    playse(SE_LEDGE)
    applymovement(player, moves(jump_in_place_right))
    msgbox("{SPEAKER NAME_PLAYER}Good luck!")
    closemessage
    applymovement(nakamura, moves(face_left))
    msgbox("{SPEAKER NAME_NAKAMURA}Gonna need that, thanks.")
    closemessage
    applymovement(nakamura, moves(walk_right, walk_down *7))
    waitmovement
    removeobject(nakamura)
    setflag(FLAG_MONKS_NAKAMURA)
}

script Entrance_Monks_MovementScript {
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if(var(VAR_TEMP_2)== 8){
        applymovement(hanzo, moves(walk_down, walk_right*4, walk_down*8))
        applymovement(player, moves(lock_facing_direction, walk_down, unlock_facing_direction))
        waitmovement(hanzo)
        applymovement(player, moves(walk_right, walk_up))
        waitmovement(player)
    }
    else{
        applymovement(hanzo, moves(walk_down*2, walk_right*4, walk_down*7))
        applymovement(player, moves(delay_16*2, face_down))
        waitmovement(hanzo)
        if(var(VAR_TEMP_2) == 7){
            applymovement(player, moves(walk_down, walk_right*2, face_up))
            
        }
        elif(var(VAR_TEMP_2) == 9){
            applymovement(player, moves(face_up))
        }
        else {
            applymovement(player, moves(walk_down, walk_left, face_up))
        }
        waitmovement(player)
        
    }
    return
}

script Entrance_Monks_FalseEnding {
    lock
    applymovement(hanzo, moves(walk_in_place_up))
    msgbox("{SPEAKER NAME_HANZO}Uff, let's see. Giratina...")
    closemessage
    applymovement(player, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Looking for something specific, sir?")
    closemessage
    faceplayer
    msgbox("{SPEAKER NAME_HANZO}Oh, hi. Yeah. I need everything you\nhave about the Distortion World.")
    closemessage
    playse(SE_PIN)
    applymovement(player, moves(emote_exclamation_mark))
    msgbox("{SPEAKER NAME_PLAYER}Oh, I finished updating that one\nthe other day.\p"
            "Just search for the keywords.\nMight be something new there.")
    closemessage
    setvar(VAR_TEMP_2, hanzo)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_HANZO}Cool, thanks.")
    waitmessage
    applymovement(hanzo, moves(face_up))
    msgbox("{SPEAKER NAME_HANZO}Okay.{PAUSE 15}.{PAUSE 15}.{PAUSE 15} Distortion world.{PAUSE 15}.{PAUSE 15}. Giratina.{PAUSE 15}.{PAUSE 15}.\nDimensional rifts.{PAUSE 15}.{PAUSE 15}.\p"
            "Seems mostly the same...")
    waitmessage
    applymovement(hanzo, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_HANZO}Wait. It needs an... anchor entity?")
    closemessage
    applymovement(player, moves(emote_exclamation_mark))
    faceplayer
    msgbox("{SPEAKER NAME_PLAYER}Oh that! Yeah. I found out that\nGiratina was the thing that kept\lthe whole Distortion World together.\p"
            "No clue why he was the one that\nheld everything together, though.")
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_PLAYER}But yeah, without it being there\nthe distortion world's going to\laffect our world.\p"
            "(wait, hold on. That seems bad.)")
    closemessage
    applymovement(hanzo, moves(face_up))
    msgbox("{SPEAKER NAME_HANZO}It also says something here about\nthe... Griseous orb?\p"
            "Okay. That's all.\nGriseous orb, hm. Got it.")
    waitmessage
    faceplayer
    msgbox("{SPEAKER NAME_HANZO}Thank you for your hard work, miss.\p"
            "Time's pressing, so I don't have\ntime to chat.\p"
            "Goobye.")
    closemessage
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Bye! Good luck with whatever\nyou're doing!")
    closemessage
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if(var(VAR_TEMP_2)==7){
        applymovement(hanzo, moves(walk_down, walk_right*4, walk_down*7))
        waitmovement(hanzo)
        applymovement(player, moves(walk_right, face_up))
        waitmovement(player)
    }
    elif(var(VAR_TEMP_2)==8){
        applymovement(hanzo, moves(walk_right*4, walk_down*7))
        waitmovement(hanzo)
        applymovement(player, moves(walk_up))
        waitmovement(player)
    }
    else{
        applymovement(hanzo, moves(walk_down, walk_right*4, walk_down*7))
        waitmovement(hanzo)
        applymovement(player, moves(walk_left, face_up))
        waitmovement(player)
    }
    msgbox("{SPEAKER NAME_PLAYER}(Hmmm... Did the situation change\nrecently?)")
    closemessage
    applymovement(player, moves(walk_in_place_up))
    delay(60)
    msgbox("{SPEAKER NAME_PLAYER}Oh. That's... a problem.\p"
            "I thought the rifts were stable?\p"
            "Wait a second, was Giratina actually\nslain?\p"
            "Oh crap, this is very, very bad.")
    closemessage
    setflag(FLAG_MONKS_FALSE_ENDING_CHAT)
    setflag(FLAG_MONKS_HANZO)
    removeobject(hanzo)
    release
}

script Entrance_Monks_TrueEnding {
    lock
    faceplayer
    playse(SE_PIN)
    applymovement(nakamura, moves(emote_exclamation_mark))
    msgbox("{SPEAKER NAME_NAKAMURA}Hey miss! Good seeing you again!")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Oh, you've returned?")
    closemessage
    setvar(VAR_TEMP_2, nakamura)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_NAKAMURA}Yep, everything went smoothly.\p"
            "Barely, though. But yeah.\nThings are fine now.")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Nice! Sounds like a good ending,\nthen.")
    closemessage
    setvar(VAR_TEMP_2, nakamura)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_NAKAMURA}Yeah. Never thought Giratina was\nike that, though.\p"
            "Nothing at all like he usually is\ndescribed.\p"
            "I can't believe milady Luciana\ndidn't just tell us.")
    waitmessage
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_NAKAMURA}This whole situation could've been\nprevented.\p"
            "And who knows what would've happened\nif we stayed too long.")
    closemessage
    applymovement(player, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}In the... Distortion World?\p"
            "Probably nothing good.")
    closemessage
    setvar(VAR_TEMP_2, nakamura)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_NAKAMURA}Mhm, I can only imagine.\p"
            "Good thing that Giratina is on our\nside though.\p"
            "I never want to go back in there\never again.\p"
            "Don't know how milady does it.")
    closemessage
    applymovement(player, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Luciana?")
    closemessage
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_NAKAMURA}Mm, better not to get involved.\p"
            "For your sake.\nTrust me.\p"
            "It's quite tiring.")
    closemessage
    applymovement(player,moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_NAKAMURA}Anyway, I just wanted to drop by\nand thank you for your service.\p"
            "Couldn't have done it without\nyour help!\p"
            "I'll be going now.")
    closemessage
    applymovement(player, moves(emote_heart))
    msgbox("{SPEAKER NAME_PLAYER}Yeah, no problem!")
    closemessage
    applymovement(nakamura, moves(walk_down, walk_right*2, walk_down*5))
    applymovement(player, moves(delay_16, face_down))
    waitmovement(nakamura)
    setflag(FLAG_MONKS_NAKAMURA)
    setflag(FLAG_MONKS_TRUE_ENDING_CHAT)
    removeobject(nakamura)
    release
}

script Entrance_Empress{
    checkbossdefeated(FINAL_BOSS_GIRATINA)
    if(var(VAR_RESULT)==FALSE){
        if(flag(FLAG_EMPRESS_INTRO)==FALSE){
            goto(Entrance_Empress_Intro)
        }
        else{
            goto(Entrance_Empress_Intro_Followup)
        }
        }
    else {
        if(var(VAR_GIRATINA_PROGRESS)<=5){
        goto(Entrance_Empress_TrueEnding)
        }
    }
}

script Entrance_Empress_Intro {
    lock
    faceplayer
    msgbox("Hey there. Cute outfit you've got.") 
    closemessage

    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if(var(VAR_TEMP_2)==33){
        applymovement(player, moves(walk_down, walk_left))
        waitmovement(player)
    }
    playse(SE_LEDGE)
    applymovement(player, moves(jump_in_place_up))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Oh thanks! Pieced it together myself.")
    closemessage
    applymovement(player, moves(lock_facing_direction, walk_down, unlock_facing_direction, face_right, delay_16, face_down, delay_16, face_left, delay_16, face_up))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}It's technically my work outfit,\nthough the only requirement\lwas a big white coat.\p"
            "For... some reason.")
    closemessage
    applymovement(empress, moves(walk_down))
    waitmovement
    msgbox("So you work here, that why that\nbrush is tied to your hair?")
    closemessage
    applymovement(player, moves(walk_right, walk_up,jump_in_place_left))
    applymovement(empress, moves(face_right))
    waitmovement(player)
    msgbox("{SPEAKER NAME_PLAYER}Yeah! Miss Satsuki has one too, so\nI figured I'd match the vibe.\p"
            "I was puzzled by her decision to\npair a white coat with a brush\ldipped in ink.\p"
            "But it seems these coats have some\nsort of special quality that\lprevents them from staining.")
    applymovement(empress, moves(walk_in_place_right))
    msgbox("I see. Maybe I need that as well, hah.\p"
            "My dress tends to get quite dirty\nquickly.\p"
            "Especially when I get dropped\nsomewhere muddy.")
    closemessage
    applymovement(player, moves(lock_facing_direction, walk_right, delay_16*3, walk_left, unlock_facing_direction))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Hmm yeah, I can see that. Lot of\nwhite in your outfit.\p"
            "Looks really cool though.\nQuite fancy as well.\p"
            "Where'd you get it?")
    closemessage
    applymovement(empress, moves(emote_heart))
    msgbox("Ah thanks!\nit's a custom made dress by Veruka.")
    closemessage
    playse(SE_PIN)
    applymovement(player, moves(emote_exclamation_mark))
    msgbox("{SPEAKER NAME_PLAYER}Whoa, Veruka!?\nDoesn't she have an insane waitlist?\p"
            "I wanted to order something from her,\nbut was told I'd have to wait more\lthan a year.")
    closemessage
    applymovement(empress, moves(emote_question_mark))
    waitmovement
    msgbox("Waitlist? She usually completes\nmy orders pretty fast.")
    closemessage
    applymovement(player, moves(face_down, delay_16*3, face_left))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Hmmm. I see. I guess you just\nhave better connections, huh?")
    closemessage
    applymovement(empress, moves(walk_in_place_right))
    waitmovement
    msgbox("Haha, something like that.")
    closemessage
    msgbox("{SPEAKER NAME_PLAYER}Damn, if only that could be me.")
    closemessage
    applymovement(empress, moves(walk_in_place_right))
    waitmovement
    msgbox("Anyway, about those coats of\nyours...")
    closemessage
    playse(SE_LEDGE)
    applymovement(player, moves(jump_in_place_left))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Oh, you'll have to ask miss Satsuki.\p"
            "But good luck.\nShe never told me anything.")
    closemessage
    applymovement(empress, moves(face_up, delay_16*4, face_right))
    waitmovement
    msgbox("Sounds good, I'll have a chat with\nSatsuki then.")
    closemessage
    applymovement(empress, moves(walk_down, walk_right*3, walk_up, face_left))
    waitmovement
    msgbox("Nice meeting you, Tiana.")
    closemessage
    playse(SE_PIN)
    applymovement(player, moves(jump_in_place_right))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Likewise, miss- wait, what?")
    closemessage
    applymovement(empress, moves(walk_in_place_left))
    waitmovement
    msgbox("{SPEAKER NAME_LUCY}You may call me Lucy.")
    closemessage
    applymovement(empress, moves(walk_up*4, walk_left*2, face_down))
    waitmovement
    msgbox("{SPEAKER NAME_LUCY}Have a nice day!")
    closemessage
    applymovement(empress, moves(walk_left*7, walk_up*2))
    waitmovement
    setvar(VAR_TEMP_F,1)
    setobjectxy(empress, 32, 12)
    setobjectxyperm(empress, 32, 12)
    setobjectmovementtype(empress, MOVEMENT_TYPE_FACE_RIGHT)
    setobjectxyperm(satsuki, 32, 11)
    setobjectmovementtype(satsuki, MOVEMENT_TYPE_FACE_DOWN)
    setflag(FLAG_EMPRESS_INTRO)
    release
}

script Entrance_Empress_Satsuki {
    lock
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if(var(VAR_TEMP_3)==11){
        applymovement(player, moves(walk_down, face_right))
    }
    elif(var(VAR_TEMP_3)==12){
        applymovement(player, moves(face_right))
    }
    elif(var(VAR_TEMP_3)==13){
        applymovement(player, moves(walk_up, face_right))
    }
    applymovement(satsuki, moves(walk_in_place_down))
    waitmovement
    msgbox("{SPEAKER NAME_SATSUKI}It might take a while to handle your\nrequest, milady.\p"
            "I will let you know when it is done.")
    closemessage
    applymovement(empress, moves(emote_heart))
    waitmovement
    msgbox("{SPEAKER NAME_LUCY}Thank you for your cooperation.")
    closemessage
    applymovement(empress, moves(face_left, delay_16*4, face_up))
    waitmovement
    msgbox("{SPEAKER NAME_LUCY}It was nice talking to both of you.\p"
            "Better than being holed up all day.\p"
            "Alas, time for me to head back.")
    applymovement(satsuki, moves(face_left))
    applymovement(empress, moves(walk_left, walk_up, walk_left, face_down delay_16*3, face_right))
    applymovement(player, moves(delay_16*2, face_up))
    waitmovement(empress)
    msgbox("{SPEAKER NAME_LUCY}Take care, both of you!")
    closemessage
    applymovement(empress, moves(walk_left, walk_down*5, walk_left*4, walk_down*4))
    applymovement(player, moves(face_down))
    waitmovement(empress)
    setobjectxyperm(empress,32,29)
    setflag(FLAG_EMPRESS)
    removeobject(empress)
    applymovement(player, moves(face_right))
    applymovement(satsuki, moves(walk_down, face_left))
    waitmovement(satsuki)
    msgbox("{SPEAKER NAME_SATSUKI}Tiana. How did you manage to get\ninvolved with her?")
    closemessage
    applymovement(player, moves(emote_question_mark))
    waitmovement
    msgbox("{SPEAKER NAME_PLAYER}Should I not have talked with her?\p"
            "You told me to treat our guests\nwell.")
    closemessage
    applymovement(satsuki, moves(face_down, delay_16*4, face_left))
    waitmovement
    msgbox("{SPEAKER NAME_SATSUKI}I suppose I did. Hmm...\p"
            "Did you not recognize her?")
    closemessage
    applymovement(player, moves(walk_in_place_right))
    msgbox("{SPEAKER NAME_PLAYER}No, why?")
    closemessage
    msgbox("{SPEAKER NAME_SATSUKI}Okay, nevermind then\p"
            "Just continue with your work.")
    applymovement(satsuki, moves(face_down))
    waitmovement
    setvar(VAR_TEMP_F, 0)
    closemessage
    release
}

script Entrance_Empress_Intro_Followup {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_LUCY}Hey Tiana! I got the enhanced dress\n back from Satsuki.\p"
            "No more worries about getting it\ndirty!")
    closemessage
    release
}

script Entrance_Empress_TrueEnding {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_LUCY}Morning Tiana! Good job on\ndeciphering Giratina's story.\p"
            "Heard it was a pretty tough nut\nto crack.\p"
            "Hmm... Wonder what THEY would think of\nthis place.")
    closemessage
    release
}

script Entrance_Chisa {
    if(flag(FLAG_CHIA_CHAT)==FALSE){
        goto(Entrance_Chisa_Intro)
    }
    else {
        goto(Entrance_Chisa_Followup)
    }
}

script Entrance_Chisa_Intro {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_CHISA}Hey hey Tiana!\p"
            "How's the job, now that you're a\nfull-fledged recordkeeper?")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}It's really fun! Also a bit confusing\nat times though")
    closemessage
    setvar(VAR_TEMP_2, chisa)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_CHISA}Mhmhm, good good.\nGlad you're having fun!\p"
            "Are you free anytime soon?\nI want to get the gang together.\p")
    closemessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndWalkInPlace)
    msgbox("{SPEAKER NAME_PLAYER}Yeah, probably.\nMy hours aren't that long.")
    waitmessage
    setvar(VAR_TEMP_2, player)
    call(Entrance_GetDirectionAndLookToSide)
    msgbox("{SPEAKER NAME_CHISA}Though, I do need to be here\nbefore midnight.\p"
            "So I won't be able to go on\nas long as before")
    closemessage
    setvar(VAR_TEMP_2, chisa)
    call(Entrance_GetDirectionAndJumpInPlace)
    msgbox("{SPEAKER NAME_PLAYER}No worries! good to hear.\p"
            "Well then, good luck with\nyour stories.\p"
            "Miss Recordkeeper.")
    closemessage
    setflag(FLAG_CHIA_CHAT)
    release
}

script Entrance_Chisa_Followup {
    lock
    faceplayer
    msgbox("{SPEAKER NAME_CHISA}By the way, I'm almost done with my\ntraining at the Archivologists.\p"
            "We may start working together soon!")
    closemessage
    release
}

script Entrance_GetDirectionAndWalkInPlace {
    getobjectfacingdirection(VAR_TEMP_2, VAR_TEMP_3) //1: south, 2: north, 3:west, 4:east
    if(var(VAR_TEMP_3)== 1 ) {
        applymovement(VAR_TEMP_2, moves(walk_in_place_down))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 2 ){
        applymovement(VAR_TEMP_2, moves(walk_in_place_up))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 3 ){
        applymovement(VAR_TEMP_2, moves(walk_in_place_left))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 4 ){
        applymovement(VAR_TEMP_2, moves(walk_in_place_right))
        waitmovement
        return
    }
    return
}


script Entrance_GetDirectionAndJumpInPlace {
    getobjectfacingdirection(VAR_TEMP_2, VAR_TEMP_3) //1: south, 2: north, 3:west, 4:east
    if(var(VAR_TEMP_3)== 1 ) {
        applymovement(VAR_TEMP_2, moves(jump_in_place_down))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 2 ){
        applymovement(VAR_TEMP_2, moves(jump_in_place_up))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 3 ){
        applymovement(VAR_TEMP_2, moves(jump_in_place_left))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 4 ){
        applymovement(VAR_TEMP_2, moves(jump_in_place_right))
        playse(SE_LEDGE)
        waitmovement
        return
    }
    return
}

script Entrance_GetDirectionAndLookToSide {
    getobjectfacingdirection(VAR_TEMP_2, VAR_TEMP_3) //1: south, 2: north, 3:west, 4:east
    if(var(VAR_TEMP_3)== 1 ) {
        applymovement(VAR_TEMP_2, moves(face_left, delay_16*3, face_down))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 2 ){
        applymovement(VAR_TEMP_2, moves(face_left, delay_16*3, face_up))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 3 ){
        applymovement(VAR_TEMP_2, moves(face_up, delay_16*3, face_left))
        waitmovement
        return
    }
    if(var(VAR_TEMP_3)== 4 ){
        applymovement(VAR_TEMP_2, moves(face_down, delay_16*3, face_right))
        waitmovement
        return
    }
    return
}

