mapscripts Winter1_MapScripts {
}

script Winter1_1 {
    checkbossstatus(1)
    if (var(VAR_RESULT) == TRUE) {
        msgbox("The image of {STR_VAR_1} has faded.")
        waitmessage
        release
        end
    }
    choosecurrentboss(1)
    waitstate
    if (var(VAR_RESULT) == TRUE) {
        warpsilent(MAP_WINTER1BOSS, 15 , 10)
    }
    release
}

