raw `
MythHub_MapScripts::
	.byte 0

MythHub_Boss::
	msgbox MythHub_TextFinalBoss, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES,
	goto_if_eq VAR_RESULT, NO,
	end

MythHub_BossYes::
	closemessage
	warpsilent MAP_BOSS
	end

MythHub_BossNo::
	closemessage
	applymovement LOCALID_PLAYER, MythHub_ExitBoss
	waitmovement 0
	releaseall
	end

MythHub_ExitBoss::
	walk_down
	step_end


MythHub_TextFinalBoss::
	.string "Beyond lies the final foe.\p"
	.string "Do you want to go through?$"
`

script MythHub_Area1 {
    choosecurrentboss(1)
    waitstate
    if (var(VAR_RESULT) == TRUE) {
        warpsilent(MAP_AREA1, 10 , 10)
    }
    end
}

