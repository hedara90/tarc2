raw `
Entrance_MapScripts::
	.byte 0
`

script Entrance_Random {
    msgbox("Set affinity to random?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setaffinity(MON_LIST_RANDOM)
    }
    closemessage
}

