mapscripts MythHub_MapScripts {
}

script MythHub_Boss {
    lockall
    msgbox("Beyond lies the final foe.\pDo you want to go through?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        callnative(SetFinalBoss)
        warpsilent(MAP_BOSS, 15, 22)
    } else {
        closemessage
        applymovement(LOCALID_PLAYER, moves(walk_down))
        waitmovement
    }
    releaseall
}

script MythHub_AfterBoss {
    fadescreen(FADE_FROM_BLACK)
    msgBox("The domain of {STR_VAR_3} collapsed.")
    callnative(CheckBossPowerUp)
    switch(var(VAR_RESULT)) {
    case 1:
        msgBox("The dissipated power energized the\nremaining foes.")
    case 2:
        msgBox("The dissipated power energized the\nremaining foes.")
    case 3:
        msgBox("The dissipated power energized the\nremaining foes.")
    case 4:
        msgBox("Blessings have been given to worthy\nrecipients.")
    }
    release
}

script MythHub_Area1 {
    checkbossstatus(1)
    if (var(VAR_RESULT) == TRUE) {
        msgbox("The image of {STR_VAR_1} has faded.")
        waitmessage
        release
        end
    }
    choosecurrentboss(1)
    waitstate
    if (var(VAR_RESULT) == TRUE) {
        warpsilent(MAP_AREA1, 15 , 10)
    }
    release
}

